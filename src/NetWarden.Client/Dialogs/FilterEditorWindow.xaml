<Window x:Class="NetWarden.Client.Dialogs.FilterEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:NetWarden.Client.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:FilterEditorViewModel}"
        Title="{Binding Title}" Width="720" Height="560" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackground}" FontFamily="Segoe UI" FontSize="13">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource BadBrush}" VerticalAlignment="Center"
                       Margin="0,0,16,0" TextWrapping="Wrap" MaxWidth="420" />
            <Button Content="Save" Width="90" Padding="0,4" IsDefault="True" Click="Save_Click" />
            <Button Content="Cancel" Width="90" Padding="0,4" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>

        <Grid DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="140" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Name" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Padding="4,3" />
            <TextBlock Grid.Column="2" Text="Type" VerticalAlignment="Center" Margin="16,0,8,0" />
            <ComboBox Grid.Column="3" ItemsSource="{Binding Types}" SelectedItem="{Binding Type}" />
            <TextBlock Grid.Column="4" Text="Per" VerticalAlignment="Center" Margin="16,0,8,0"
                       ToolTip="Split limits into separate buckets per app, process or connection" />
            <ComboBox Grid.Column="5" ItemsSource="{Binding PerTypes}" SelectedItem="{Binding PerType}" />
        </Grid>

        <TextBox DockPanel.Dock="Bottom" Margin="0,12,0,0" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                 Padding="4,3" ToolTip="Notes" />

        <GroupBox DockPanel.Dock="Bottom" Header="Base filters (traffic must match at least one)" Margin="0,12,0,0"
                  MaxHeight="130">
            <GroupBox.Style>
                <Style TargetType="GroupBox">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsComposite}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </GroupBox.Style>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding BaseFilters}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:BaseFilterChoice}">
                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" Margin="2" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </GroupBox>

        <GroupBox Header="Filter functions (all must match; no functions = all traffic)" Margin="0,12,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,4,0,8">
                    <Button Content="Add function" Padding="10,3" Command="{Binding AddFunctionCommand}" />
                    <Button Content="Remove" Padding="10,3" Margin="8,0,0,0"
                            Command="{Binding RemoveFunctionCommand}" CommandParameter="{Binding SelectedFunction}" />
                </StackPanel>
                <ListBox ItemsSource="{Binding Functions}" SelectedItem="{Binding SelectedFunction}"
                         HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:FunctionItem}">
                            <Grid Margin="2,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{Binding DataContext.FunctionKinds, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedItem="{Binding Kind}" VerticalAlignment="Top" />
                                <ComboBox Grid.Column="1" Margin="6,0" SelectedIndex="{Binding Match, Converter={StaticResource MatchToIndex}}"
                                          VerticalAlignment="Top">
                                    <ComboBoxItem Content="is" />
                                    <ComboBoxItem Content="is not" />
                                </ComboBox>
                                <StackPanel Grid.Column="2">
                                    <TextBox Text="{Binding ValuesText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                                             MinHeight="24" MaxHeight="90" VerticalScrollBarVisibility="Auto" Padding="3,2"
                                             IsEnabled="{Binding TakesValues}" />
                                    <TextBlock Text="{Binding Hint}" Foreground="{DynamicResource MutedText}" FontSize="11" Margin="2,2,0,0" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </GroupBox>
    </DockPanel>
</Window>
