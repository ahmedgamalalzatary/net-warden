<Window x:Class="NetWarden.Client.Dialogs.QuotaAlertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quota exceeded" Width="400" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Topmost="True"
        Background="{DynamicResource WindowBackground}" FontFamily="Segoe UI" FontSize="13">
    <StackPanel Margin="16">
        <TextBlock x:Name="Heading" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock x:Name="Detail" Margin="0,6,0,0" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Reset quota" Padding="10,4" Click="Reset_Click" />
            <Button Content="Close" Width="80" Padding="0,4" Margin="8,0,0,0" IsCancel="True" IsDefault="True" Click="Close_Click" />
        </StackPanel>
    </StackPanel>
</Window>
