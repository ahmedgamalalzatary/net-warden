<Window x:Class="NetWarden.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:NetWarden.Client.ViewModels"
        xmlns:ipc="clr-namespace:NetWarden.Shared.Ipc;assembly=NetWarden.Shared"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="NetWarden" Width="1000" Height="640" MinWidth="640" MinHeight="400"
        Background="{StaticResource WindowBackground}"
        FontFamily="Segoe UI" FontSize="13">
    <DockPanel>
        <!-- Header: product name and global feature switches (wired up in later phases) -->
        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBackground}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,10">
            <DockPanel>
                <TextBlock Text="NetWarden" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            IsEnabled="{Binding IsConnected}">
                    <Border Style="{StaticResource FeatureChip}">
                        <CheckBox Content="Limiter" IsChecked="{Binding Settings.IsLimiterEnabled, Mode=OneWay}" IsHitTestVisible="False" />
                    </Border>
                    <Border Style="{StaticResource FeatureChip}">
                        <CheckBox Content="Blocker" IsChecked="{Binding Settings.IsBlockerEnabled, Mode=OneWay}" IsHitTestVisible="False" />
                    </Border>
                    <Border Style="{StaticResource FeatureChip}">
                        <CheckBox Content="Priorities" IsChecked="{Binding Settings.IsPriorityEnabled, Mode=OneWay}" IsHitTestVisible="False" />
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBackground}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,6">
            <DockPanel>
                <Ellipse Width="9" Height="9" Margin="0,0,8,0" VerticalAlignment="Center">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{StaticResource BadBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ConnectionState}" Value="{x:Static ipc:ConnectionState.Connected}">
                                    <Setter Property="Fill" Value="{StaticResource OkBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ConnectionState}" Value="{x:Static ipc:ConnectionState.Connecting}">
                                    <Setter Property="Fill" Value="{StaticResource WarnBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding ServiceSummary}" Foreground="{StaticResource MutedText}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- Main area: the Activity view lands here in phase 1 -->
        <Border Margin="16" Background="{StaticResource PanelBackground}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                <TextBlock Text="Activity" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="{StaticResource MutedText}"
                           Text="Per-app traffic will appear here once monitoring is built." />
                <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="{StaticResource BadBrush}" Text="{Binding StatusText}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>
    </DockPanel>
</Window>
