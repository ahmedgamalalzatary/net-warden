<!-- Colors of the light theme. Same keys in both. The rail stays harbour blue-green in either. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WindowBackground" Color="#EDF1F0" />
    <SolidColorBrush x:Key="PanelBackground" Color="#FBFCFB" />
    <SolidColorBrush x:Key="AltRowBackground" Color="#F3F6F5" />
    <SolidColorBrush x:Key="BorderBrush" Color="#D3DCDA" />
    <SolidColorBrush x:Key="TextBrush" Color="#15292C" />
    <SolidColorBrush x:Key="MutedText" Color="#4F6367" />
    <SolidColorBrush x:Key="DimText" Color="#7F9195" />
    <SolidColorBrush x:Key="SelectionBackground" Color="#CFE6E6" />
    <SolidColorBrush x:Key="AccentBrush" Color="#0E7C86" />
    <SolidColorBrush x:Key="OkBrush" Color="#1C8A55" />
    <SolidColorBrush x:Key="WarnBrush" Color="#B7791F" />
    <SolidColorBrush x:Key="BadBrush" Color="#C23A3A" />
    <SolidColorBrush x:Key="ChartInBrush" Color="#0E8A8F" />
    <SolidColorBrush x:Key="ChartOutBrush" Color="#B0447E" />
    <SolidColorBrush x:Key="ChartGridBrush" Color="#DFE6E4" />
    <SolidColorBrush x:Key="RailBackground" Color="#0F3B40" />
    <SolidColorBrush x:Key="RailText" Color="#E4F0EE" />
    <SolidColorBrush x:Key="RailMuted" Color="#94B5B3" />
    <SolidColorBrush x:Key="RailHover" Color="#1A4C52" />
    <SolidColorBrush x:Key="RailSelected" Color="#1F5A60" />
    <SolidColorBrush x:Key="SignalBrush" Color="#F2C230" />
    <SolidColorBrush x:Key="RailIn" Color="#6FD6D9" />
    <SolidColorBrush x:Key="RailOut" Color="#F0A0CC" />
</ResourceDictionary>
