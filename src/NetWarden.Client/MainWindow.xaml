<Window x:Class="NetWarden.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NetWarden.Client"
        xmlns:vm="clr-namespace:NetWarden.Client.ViewModels"
        xmlns:charts="clr-namespace:NetWarden.Client.Charts"
        xmlns:ipc="clr-namespace:NetWarden.Shared.Ipc;assembly=NetWarden.Shared"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="NetWarden" Width="1180" Height="760" MinWidth="720" MinHeight="460"
        Background="{StaticResource WindowBackground}"
        FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <local:BindingProxy x:Key="Proxy" Data="{Binding}" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="NumberCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>

        <Style x:Key="ToolbarLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Foreground" Value="{StaticResource MutedText}" />
        </Style>

        <ContextMenu x:Key="RowMenu" Opened="RowMenu_Opened">
            <MenuItem Tag="rule" Header="Add rule..." Click="AddRuleForRow_Click" FontWeight="SemiBold" />
            <MenuItem Tag="expand" Header="Expand / collapse" Click="Expand_Click" />
            <Separator />
            <MenuItem Tag="kill" Header="Kill connection(s)" Click="Kill_Click" />
            <MenuItem Tag="hide" Header="Hide app" Click="Hide_Click" />
            <Separator />
            <MenuItem Header="Copy" Click="Copy_Click" />
            <MenuItem Tag="folder" Header="Open file location" Click="OpenFolder_Click" />
        </ContextMenu>
    </Window.Resources>

    <DockPanel>
        <!-- Header: product name and global feature switches (wired up in later phases) -->
        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBackground}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,10">
            <DockPanel>
                <TextBlock Text="NetWarden" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" IsEnabled="{Binding IsConnected}">
                    <Border Style="{StaticResource FeatureChip}">
                        <CheckBox Content="Limiter" IsChecked="{Binding IsLimiterEnabled}" ToolTip="Turn limiter on or off for the whole computer" />
                    </Border>
                    <Border Style="{StaticResource FeatureChip}">
                        <CheckBox Content="Blocker" IsChecked="{Binding IsBlockerEnabled}" ToolTip="Turn blocker on or off for the whole computer" />
                    </Border>
                    <Border Style="{StaticResource FeatureChip}">
                        <CheckBox Content="Priorities" IsChecked="{Binding IsPriorityEnabled}" ToolTip="Turn priorities on or off for the whole computer" />
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBackground}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,6">
            <DockPanel>
                <Ellipse Width="9" Height="9" Margin="0,0,8,0" VerticalAlignment="Center">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{StaticResource BadBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ConnectionState}" Value="{x:Static ipc:ConnectionState.Connected}">
                                    <Setter Property="Fill" Value="{StaticResource OkBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ConnectionState}" Value="{x:Static ipc:ConnectionState.Connecting}">
                                    <Setter Property="Fill" Value="{StaticResource WarnBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Activity.LastError}" Foreground="{StaticResource BadBrush}" Margin="16,0,0,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding ServiceSummary}" Foreground="{StaticResource MutedText}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <TabControl x:Name="Tabs" Margin="8,8,8,0" Background="Transparent" BorderThickness="0,1,0,0">
        <TabItem Header="Activity" Padding="14,4">
        <DockPanel>
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Padding="16,10,16,0">
            <DockPanel LastChildFill="False">
                <TextBlock Text="Show" Style="{StaticResource ToolbarLabel}" />
                <ComboBox Width="90" ItemsSource="{Binding Activity.Filters}" SelectedItem="{Binding Activity.Filter}" />
                <TextBox Width="220" Margin="12,0,0,0" VerticalContentAlignment="Center" Padding="4,2"
                         Text="{Binding Activity.Search, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Search apps, paths and addresses" />
                <TextBlock Text="Units" Style="{StaticResource ToolbarLabel}" Margin="16,0,6,0" />
                <ComboBox Width="80" ItemsSource="{Binding Activity.UnitModes}" SelectedItem="{Binding Activity.Units}" />
                <Menu Margin="12,0,0,0" VerticalAlignment="Center" Background="Transparent">
                    <MenuItem Header="Columns ▾" Padding="6,3">
                        <MenuItem Header="DL rate" IsCheckable="True" IsChecked="{Binding ShowRateIn}" />
                        <MenuItem Header="UL rate" IsCheckable="True" IsChecked="{Binding ShowRateOut}" />
                        <MenuItem Header="DL total" IsCheckable="True" IsChecked="{Binding ShowTotalIn}" />
                        <MenuItem Header="UL total" IsCheckable="True" IsChecked="{Binding ShowTotalOut}" />
                    </MenuItem>
                    <MenuItem Header="View ▾" Padding="6,3">
                        <MenuItem Header="Info pane" IsCheckable="True" IsChecked="{Binding ShowInfoPane}" />
                        <MenuItem Header="Traffic chart" IsCheckable="True" IsChecked="{Binding ShowChart}" />
                    </MenuItem>
                </Menu>
                <Button DockPanel.Dock="Right" Content="Reset totals" Padding="10,3" Click="ResetTotals_Click"
                        IsEnabled="{Binding IsConnected}" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding Activity.TotalsText}" Margin="0,0,16,0"
                           VerticalAlignment="Center" Foreground="{StaticResource MutedText}" />
            </DockPanel>
        </Border>

        <!-- Chart -->
        <Border DockPanel.Dock="Bottom" Margin="16,0,16,12" Height="170"
                Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="6" Padding="10,6"
                Visibility="{Binding ShowChart, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                    <TextBlock Text="{Binding ChartTitle}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Rectangle Width="12" Height="3" Fill="#2563EB" VerticalAlignment="Center" />
                        <TextBlock Text="Download" Margin="4,0,12,0" Foreground="{StaticResource MutedText}" />
                        <Rectangle Width="12" Height="3" Fill="#EA580C" VerticalAlignment="Center" />
                        <TextBlock Text="Upload" Margin="4,0,12,0" Foreground="{StaticResource MutedText}" />
                        <ComboBox ItemsSource="{Binding ChartWindows}" SelectedItem="{Binding ChartWindowSeconds}" Width="70"
                                  ItemStringFormat="{}{0} s" />
                    </StackPanel>
                </DockPanel>
                <charts:TrafficChart x:Name="Chart" History="{Binding ChartHistory}"
                                     WindowSeconds="{Binding ChartWindowSeconds}" Units="{Binding Activity.Units}" />
            </DockPanel>
        </Border>

        <!-- Main area: activity grid and info pane -->
        <Grid Margin="16,10,16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <DataGrid x:Name="ActivityGrid" Grid.Column="0" ItemsSource="{Binding Activity.Rows}"
                      SelectedItem="{Binding SelectedRow}"
                      AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                      HeadersVisibility="Column" GridLinesVisibility="None" RowHeight="24"
                      CanUserReorderColumns="True" CanUserResizeRows="False"
                      Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource BorderBrush}"
                      RowBackground="{StaticResource PanelBackground}" AlternatingRowBackground="#FAFBFC"
                      EnableRowVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling"
                      Sorting="ActivityGrid_Sorting" MouseDoubleClick="ActivityGrid_MouseDoubleClick">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="ContextMenu" Value="{StaticResource RowMenu}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                <Setter Property="Foreground" Value="#9AA3AF" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsApp}" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource MutedText}" />
                                <Setter Property="FontSize" Value="12" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Name" Width="*" SortMemberPath="Name" MinWidth="200">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type vm:ActivityRow}">
                                <StackPanel Orientation="Horizontal" ToolTip="{Binding Detail}">
                                    <Border Width="{Binding Indent}" />
                                    <!-- UpdateSourceTrigger must be explicit: DataGrid otherwise defers cell
                                         bindings to its row BindingGroup, which a read-only grid never commits. -->
                                    <ToggleButton Width="16" Height="16" Margin="2,0" Padding="0" BorderThickness="0"
                                                  Background="Transparent" Focusable="False"
                                                  IsChecked="{Binding IsExpanded, UpdateSourceTrigger=PropertyChanged}">
                                        <ToggleButton.Style>
                                            <Style TargetType="ToggleButton">
                                                <Setter Property="Visibility" Value="Hidden" />
                                                <Setter Property="Content" Value="▸" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasChildren}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsApp}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter Property="Content" Value="▾" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ToggleButton.Style>
                                    </ToggleButton>
                                    <Image Source="{Binding Icon}" Width="16" Height="16" Margin="2,0,6,0"
                                           Visibility="{Binding IsApp, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Block in" Width="62" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type vm:ActivityRow}">
                                <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" Tag="In"
                                          IsChecked="{Binding IsBlockedIn, Mode=OneWay}" Click="QuickBlock_Click"
                                          Visibility="{Binding IsApp, Converter={StaticResource BoolToVis}}"
                                          ToolTip="Block incoming connections of this app" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Block out" Width="68" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type vm:ActivityRow}">
                                <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" Tag="Out"
                                          IsChecked="{Binding IsBlockedOut, Mode=OneWay}" Click="QuickBlock_Click"
                                          Visibility="{Binding IsApp, Converter={StaticResource BoolToVis}}"
                                          ToolTip="Block outgoing connections of this app" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="DL Rate" Width="95" SortMemberPath="RateIn" Binding="{Binding RateInText}"
                                        ElementStyle="{StaticResource NumberCell}"
                                        Visibility="{Binding Data.ShowRateIn, Source={StaticResource Proxy}, Converter={StaticResource BoolToVis}}" />
                    <DataGridTextColumn Header="UL Rate" Width="95" SortMemberPath="RateOut" Binding="{Binding RateOutText}"
                                        ElementStyle="{StaticResource NumberCell}"
                                        Visibility="{Binding Data.ShowRateOut, Source={StaticResource Proxy}, Converter={StaticResource BoolToVis}}" />
                    <DataGridTextColumn Header="DL Total" Width="90" SortMemberPath="TotalIn" Binding="{Binding TotalInText}"
                                        ElementStyle="{StaticResource NumberCell}"
                                        Visibility="{Binding Data.ShowTotalIn, Source={StaticResource Proxy}, Converter={StaticResource BoolToVis}}" />
                    <DataGridTextColumn Header="UL Total" Width="90" SortMemberPath="TotalOut" Binding="{Binding TotalOutText}"
                                        ElementStyle="{StaticResource NumberCell}"
                                        Visibility="{Binding Data.ShowTotalOut, Source={StaticResource Proxy}, Converter={StaticResource BoolToVis}}" />
                </DataGrid.Columns>
            </DataGrid>

            <!-- Shown over the empty grid when not connected -->
            <TextBlock Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                       MaxWidth="420" TextAlignment="Center" Foreground="{StaticResource BadBrush}" Text="{Binding StatusText}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Center" Background="Transparent"
                          Visibility="{Binding ShowInfoPane, Converter={StaticResource BoolToVis}}" />

            <Border Grid.Column="2" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="12"
                    Visibility="{Binding ShowInfoPane, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding Info.Title}" FontSize="15" FontWeight="SemiBold"
                               TextWrapping="Wrap" Margin="0,0,0,10" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Info.Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:InfoItem}">
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="{Binding Label}" Foreground="{StaticResource MutedText}" FontSize="11" />
                                        <TextBox Text="{Binding Value, Mode=OneWay}" IsReadOnly="True" BorderThickness="0"
                                                 Background="Transparent" TextWrapping="Wrap" Padding="0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
        </DockPanel>
        </TabItem>

        <!-- Blocker -->
        <TabItem Header="Blocker" Padding="14,4">
            <DockPanel Margin="8">
                <Border DockPanel.Dock="Top" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,10" IsEnabled="{Binding IsConnected}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox Content="Blocker enabled" IsChecked="{Binding IsBlockerEnabled}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Text="Unmatched incoming:" Margin="28,0,6,0" VerticalAlignment="Center" />
                            <ComboBox Width="80" ItemsSource="{Binding FirewallActions}" SelectedItem="{Binding DefaultFirewallIn}"
                                      ToolTip="What happens to incoming connections no blocker rule matches" />
                            <TextBlock Text="Unmatched outgoing:" Margin="20,0,6,0" VerticalAlignment="Center" />
                            <ComboBox Width="80" ItemsSource="{Binding FirewallActions}" SelectedItem="{Binding DefaultFirewallOut}"
                                      ToolTip="What happens to outgoing connections no blocker rule matches. Ask shows a prompt." />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="Quick zone blocker:" VerticalAlignment="Center" Foreground="{StaticResource MutedText}" />
                            <CheckBox Content="Block Internet in" IsChecked="{Binding BlockInternetIn}" Margin="12,0,0,0" />
                            <CheckBox Content="Block Internet out" IsChecked="{Binding BlockInternetOut}" Margin="12,0,0,0" />
                            <CheckBox Content="Block local network in" IsChecked="{Binding BlockLocalIn}" Margin="24,0,0,0" />
                            <CheckBox Content="Block local network out" IsChecked="{Binding BlockLocalOut}" Margin="12,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding Blocker.StatusText}" Margin="0,10,0,0" Foreground="{StaticResource MutedText}" />
                        <TextBlock Text="{Binding Blocker.LastError}" Foreground="{StaticResource BadBrush}" />
                    </StackPanel>
                </Border>
                <TextBlock DockPanel.Dock="Top" Text="Pending blocker requests" FontWeight="SemiBold" Margin="2,0,0,6" />
                <TextBlock DockPanel.Dock="Bottom" Margin="2,8,0,0" Foreground="{StaticResource MutedText}"
                           Text="Blocker rules are listed with all other rules in the Rules tab. Quick block per app is in the Activity tab." />
                <DataGrid x:Name="PendingGrid" ItemsSource="{Binding Blocker.Pending}" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="None" RowHeight="28" SelectionMode="Single"
                          Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource BorderBrush}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Application" Binding="{Binding App.DisplayName}" Width="200" />
                        <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="80" />
                        <DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="70" />
                        <DataGridTextColumn Header="Remote" Binding="{Binding RemoteAddress}" Width="160" />
                        <DataGridTextColumn Header="Port" Binding="{Binding RemotePort}" Width="60" />
                        <DataGridTextColumn Header="Host" Binding="{Binding RemoteHost}" Width="*" />
                        <DataGridTemplateColumn Header="" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Allow" Padding="10,1" Click="PendingAllow_Click" />
                                        <Button Content="Deny" Padding="10,1" Margin="6,0,0,0" Click="PendingDeny_Click" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </TabItem>

        <!-- Filters -->
        <TabItem Header="Filters" Padding="14,4">
            <DockPanel Margin="8">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="Add filter" Padding="10,3" Click="AddFilter_Click" IsEnabled="{Binding IsConnected}" />
                    <Button Content="Edit" Padding="10,3" Margin="8,0,0,0" Click="EditFilter_Click" IsEnabled="{Binding IsConnected}" />
                    <Button Content="Delete" Padding="10,3" Margin="8,0,0,0" Click="DeleteFilter_Click" IsEnabled="{Binding IsConnected}" />
                    <Button Content="Add rule for filter" Padding="10,3" Margin="24,0,0,0" Click="AddRuleForFilter_Click" IsEnabled="{Binding IsConnected}" />
                    <TextBlock Text="{Binding Rules.LastError}" Foreground="{StaticResource BadBrush}" Margin="16,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <DataGrid x:Name="FiltersGrid" ItemsSource="{Binding Rules.Filters}" SelectedItem="{Binding Rules.SelectedFilter}"
                          AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column"
                          GridLinesVisibility="None" RowHeight="24" Background="{StaticResource PanelBackground}"
                          BorderBrush="{StaticResource BorderBrush}" AlternatingRowBackground="#FAFBFC"
                          MouseDoubleClick="FiltersGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="220" />
                        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="90" />
                        <DataGridTextColumn Header="Per" Binding="{Binding PerType}" Width="100" />
                        <DataGridTextColumn Header="Rules" Binding="{Binding RuleCount}" Width="60" />
                        <DataGridCheckBoxColumn Header="Predefined" Binding="{Binding IsPredefined, Mode=OneWay}" Width="80" />
                        <DataGridTextColumn Header="Definition" Binding="{Binding Definition}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </TabItem>

        <!-- Rules -->
        <TabItem Header="Rules" Padding="14,4">
            <DockPanel Margin="8">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="Add rule" Padding="10,3" Click="AddRule_Click" IsEnabled="{Binding IsConnected}" />
                    <Button Content="Edit" Padding="10,3" Margin="8,0,0,0" Click="EditRule_Click" IsEnabled="{Binding IsConnected}" />
                    <Button Content="Delete" Padding="10,3" Margin="8,0,0,0" Click="DeleteRule_Click" IsEnabled="{Binding IsConnected}" />
                    <Button Content="Enable / disable" Padding="10,3" Margin="8,0,0,0" IsEnabled="{Binding IsConnected}"
                            Command="{Binding Rules.ToggleEnabledCommand}" CommandParameter="{Binding Rules.SelectedRule}" />
                    <Button Content="Move up" Padding="10,3" Margin="24,0,0,0" IsEnabled="{Binding IsConnected}"
                            Command="{Binding Rules.MoveUpCommand}" CommandParameter="{Binding Rules.SelectedRule}"
                            ToolTip="Among rules of equal weight, the first matching one wins" />
                    <Button Content="Move down" Padding="10,3" Margin="8,0,0,0" IsEnabled="{Binding IsConnected}"
                            Command="{Binding Rules.MoveDownCommand}" CommandParameter="{Binding Rules.SelectedRule}" />
                    <TextBlock Text="{Binding Rules.LastError}" Foreground="{StaticResource BadBrush}" Margin="16,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <DataGrid x:Name="RulesGrid" ItemsSource="{Binding Rules.Rules}" SelectedItem="{Binding Rules.SelectedRule}"
                          AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column"
                          GridLinesVisibility="None" RowHeight="24" Background="{StaticResource PanelBackground}"
                          BorderBrush="{StaticResource BorderBrush}" AlternatingRowBackground="#FAFBFC"
                          MouseDoubleClick="RulesGrid_MouseDoubleClick">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                    <Setter Property="Foreground" Value="#9AA3AF" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="On" Binding="{Binding IsEnabled, Mode=OneWay}" Width="40" />
                        <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="80" />
                        <DataGridTextColumn Header="For" Binding="{Binding For}" Width="200" />
                        <DataGridTextColumn Header="Dir" Binding="{Binding Direction}" Width="55" />
                        <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="150" />
                        <DataGridTextColumn Header="Weight" Binding="{Binding Weight}" Width="60" />
                        <DataGridTextColumn Header="State" Binding="{Binding State}" Width="75" />
                        <DataGridTextColumn Header="Expires" Binding="{Binding Expires}" Width="120" />
                        <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </TabItem>
        </TabControl>
    </DockPanel>
</Window>
