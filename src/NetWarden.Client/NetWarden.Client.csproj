<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/NetWarden.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NetWarden.Shared\NetWarden.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets/NetWarden.ico" />
    <Resource Include="Assets/Flags/*.png" />
    <EmbeddedResource Include="Assets/Lang/*.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- Only the tray icon uses Windows Forms; its names must not clash with WPF's everywhere else. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NetWarden.Tests" />
  </ItemGroup>

</Project>
