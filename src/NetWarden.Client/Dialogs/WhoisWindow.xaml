<Window x:Class="NetWarden.Client.Dialogs.WhoisWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="640" Height="560" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}" FontFamily="Segoe UI" FontSize="13">
    <TextBox x:Name="Answer" Margin="12" IsReadOnly="True" FontFamily="Consolas" TextWrapping="NoWrap"
             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Text="Asking the WHOIS servers..." />
</Window>
