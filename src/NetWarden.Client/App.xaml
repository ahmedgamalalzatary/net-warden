<Application x:Class="NetWarden.Client.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:NetWarden.Client"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
        <!-- Our colors; ThemeManager swaps this for Themes/Dark.xaml and turns on Fluent's matching mode. -->
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="pack://application:,,,/NetWarden.Client;component/Themes/Light.xaml" />
        </ResourceDictionary.MergedDictionaries>
        <local:MatchToIndexConverter x:Key="MatchToIndex" />
        <local:EnumToBoolConverter x:Key="EnumToBool" />

        <!-- Display type: Bahnschrift ships with Windows and has the look of road signs and instrument panels. -->
        <FontFamily x:Key="DisplayFont">Bahnschrift, Segoe UI</FontFamily>

        <!-- One page in the rail. The yellow bar is the only marker of where you are. -->
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="GroupName" Value="Nav" />
            <Setter Property="Foreground" Value="{DynamicResource RailText}" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Border x:Name="Fill" Margin="8,1" CornerRadius="4" />
                            <Border x:Name="Marker" Width="3" HorizontalAlignment="Left" Margin="8,5" CornerRadius="2"
                                    Background="{DynamicResource SignalBrush}" Visibility="Hidden" />
                            <ContentPresenter Margin="22,6,12,6" VerticalAlignment="Center" />
                            <Border x:Name="Focus" Margin="8,1" CornerRadius="4" BorderThickness="1"
                                    BorderBrush="{DynamicResource SignalBrush}" Visibility="Hidden" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fill" Property="Background" Value="{DynamicResource RailHover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Fill" Property="Background" Value="{DynamicResource RailSelected}" />
                                <Setter TargetName="Marker" Property="Visibility" Value="Visible" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Focus" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavGroup" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource RailMuted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="22,14,12,4" />
        </Style>

        <!-- A master switch in the rail. -->
        <Style x:Key="RailSwitch" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource RailText}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="22,4,16,4" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                            <Border x:Name="Track" Width="30" Height="16" CornerRadius="8" HorizontalAlignment="Right"
                                    Background="{DynamicResource RailHover}" BorderBrush="{DynamicResource RailMuted}" BorderThickness="1">
                                <Ellipse x:Name="Knob" Width="10" Height="10" HorizontalAlignment="Left" Margin="2,0" Fill="{DynamicResource RailMuted}" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource SignalBrush}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource SignalBrush}" />
                                <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource RailBackground}" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource RailText}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The main action of a page. -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Body" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Body" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Body" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="Section" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <!-- The tab control is only a pager: the rail does the navigating. -->
        <Style x:Key="Pager" TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <ContentPresenter ContentSource="SelectedContent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
