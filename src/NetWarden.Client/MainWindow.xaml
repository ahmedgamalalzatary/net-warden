<Window x:Class="NetWarden.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NetWarden.Client"
        xmlns:vm="clr-namespace:NetWarden.Client.ViewModels"
        xmlns:charts="clr-namespace:NetWarden.Client.Charts"
        xmlns:svc="clr-namespace:NetWarden.Client.Services"
        xmlns:ipc="clr-namespace:NetWarden.Shared.Ipc;assembly=NetWarden.Shared"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="NetWarden" Icon="pack://application:,,,/NetWarden.Client;component/Assets/NetWarden.ico" Width="1360" Height="820" MinWidth="900" MinHeight="560"
        Background="{DynamicResource WindowBackground}"
        FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <local:BindingProxy x:Key="Proxy" Data="{Binding}" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:FlagImageConverter x:Key="FlagImage" />
        <svc:TranslateConverter x:Key="Translate" />
        <vm:HotkeyTargetNameConverter x:Key="HotkeyTargetName" />

        <Style x:Key="NumberCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>

        <Style x:Key="LimitBox" TargetType="TextBox">
            <Setter Property="Width" Value="54" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Padding" Value="2,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        </Style>
        <Style x:Key="ToolbarLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Foreground" Value="{DynamicResource MutedText}" />
        </Style>

        <ContextMenu x:Key="RowMenu" Opened="RowMenu_Opened">
            <MenuItem Tag="rule" Header="{svc:T Add rule...}" Click="AddRuleForRow_Click" FontWeight="SemiBold" />
            <MenuItem Tag="expand" Header="Expand / collapse" Click="Expand_Click" />
            <MenuItem Tag="history" Header="Connection history" Click="ShowHistory_Click" />
            <Separator />
            <MenuItem Tag="kill" Header="Kill connection(s)" Click="Kill_Click" />
            <MenuItem Tag="hide" Header="Hide app" Click="Hide_Click" />
            <Separator />
            <MenuItem Header="Copy" Click="Copy_Click" />
            <MenuItem Tag="folder" Header="Open file location" Click="OpenFolder_Click" />
        </ContextMenu>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="212" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Rail: where you are, what the line is doing, and the master switches -->
        <DockPanel Background="{DynamicResource RailBackground}">
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="NetWarden" FontFamily="{StaticResource DisplayFont}" FontSize="20" Foreground="{DynamicResource RailText}" Margin="22,18,12,10" />
                <Grid Margin="22,0,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition /><RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock Text="↓" Foreground="{DynamicResource RailIn}" FontSize="18" Margin="0,0,8,0" ToolTip="{svc:T Download}" />
                    <TextBlock x:Name="RailDownloadText" Grid.Column="1" Text="{Binding RailDownload}" FlowDirection="LeftToRight" HorizontalAlignment="Left" FontFamily="{StaticResource DisplayFont}" FontSize="18" Foreground="{DynamicResource RailText}" />
                    <TextBlock Grid.Row="1" Text="↑" Foreground="{DynamicResource RailOut}" FontSize="18" ToolTip="{svc:T Upload}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding RailUpload}" FlowDirection="LeftToRight" HorizontalAlignment="Left" FontFamily="{StaticResource DisplayFont}" FontSize="18" Foreground="{DynamicResource RailText}" />
                </Grid>
                <charts:TrafficChart x:Name="RailChart" Height="44" Margin="22,8,16,4" IsCompact="True" History="{Binding ComputerHistory}" WindowSeconds="120"
                                     InBrush="{DynamicResource RailIn}" OutBrush="{DynamicResource RailOut}" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,12">
                <StackPanel IsEnabled="{Binding IsConnected}">
                    <CheckBox Style="{StaticResource RailSwitch}" Content="{svc:T Limiter}" IsChecked="{Binding IsLimiterEnabled}" ToolTip="{Binding Blocker.LimiterStatusText}" />
                    <CheckBox Style="{StaticResource RailSwitch}" Content="{svc:T Blocker}" IsChecked="{Binding IsBlockerEnabled}" ToolTip="{Binding Blocker.StatusText}" />
                    <CheckBox Style="{StaticResource RailSwitch}" Content="{svc:T Priorities}" IsChecked="{Binding IsPriorityEnabled}" ToolTip="{Binding Priorities.StateText}" />
                </StackPanel>
                <RadioButton x:Name="NavSettings" Tag="Settings" Style="{StaticResource NavItem}" Content="{svc:T Settings}" Margin="0,8,0,0" Click="Nav_Click" />
                <StackPanel Orientation="Horizontal" Margin="22,10,12,0" ToolTip="{Binding ServiceSummary}">
                    <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource BadBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ConnectionState}" Value="{x:Static ipc:ConnectionState.Connected}">
                                        <Setter Property="Fill" Value="{DynamicResource OkBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ConnectionState}" Value="{x:Static ipc:ConnectionState.Connecting}">
                                        <Setter Property="Fill" Value="{DynamicResource WarnBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource RailMuted}" FontSize="12" MaxWidth="160" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="Nav">
                    <TextBlock Text="{svc:T Monitor}" Style="{StaticResource NavGroup}" />
                    <RadioButton Tag="Activity" Style="{StaticResource NavItem}" Content="{svc:T Activity}" Click="Nav_Click" />
                    <RadioButton Tag="Statistics" Style="{StaticResource NavItem}" Content="{svc:T Statistics}" Click="Nav_Click" />
                    <RadioButton Tag="Log" Style="{StaticResource NavItem}" Content="{svc:T Log}" Click="Nav_Click" />
                    <RadioButton Tag="History" Style="{StaticResource NavItem}" Content="{svc:T History}" Click="Nav_Click" />
                    <TextBlock Text="{svc:T Control}" Style="{StaticResource NavGroup}" />
                    <RadioButton Tag="Rules" Style="{StaticResource NavItem}" Content="{svc:T Rules}" Click="Nav_Click" />
                    <RadioButton Tag="Blocker" Style="{StaticResource NavItem}" Content="{svc:T Blocker}" Click="Nav_Click" />
                    <RadioButton Tag="Priorities" Style="{StaticResource NavItem}" Content="{svc:T Priorities}" Click="Nav_Click" />
                    <RadioButton Tag="Quotas" Style="{StaticResource NavItem}" Content="{svc:T Quotas}" Click="Nav_Click" />
                    <TextBlock Text="{svc:T Library}" Style="{StaticResource NavGroup}" />
                    <RadioButton Tag="Filters" Style="{StaticResource NavItem}" Content="{svc:T Filters}" Click="Nav_Click" />
                    <RadioButton Tag="Apps" Style="{StaticResource NavItem}" Content="{svc:T Apps}" Click="Nav_Click" />
                    <RadioButton Tag="Networks" Style="{StaticResource NavItem}" Content="{svc:T Networks}" Click="Nav_Click" />
                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <!-- The open page -->
        <DockPanel Grid.Column="1">
            <TextBlock DockPanel.Dock="Top" x:Name="PageTitle" FontFamily="{StaticResource DisplayFont}" FontSize="24" Margin="24,16,24,4"
                       Text="{Binding SelectedItem.Header, ElementName=Tabs, Converter={StaticResource Translate}}" />
            <TabControl x:Name="Tabs" Style="{StaticResource Pager}" Margin="16,0,16,12">
        <TabItem Header="Activity">
        <DockPanel>
        <!-- Toolbar -->
        <DockPanel DockPanel.Dock="Top" Margin="8,8,8,0" LastChildFill="False">
            <ComboBox Width="96" ItemsSource="{Binding Activity.Filters}" SelectedItem="{Binding Activity.Filter}" ToolTip="Which apps to list" />
            <TextBox Width="240" Margin="8,0,0,0" VerticalContentAlignment="Center"
                     Text="{Binding Activity.Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search apps, paths and addresses" />
            <Button DockPanel.Dock="Right" Content="{svc:T Reset totals}" Click="ResetTotals_Click" IsEnabled="{Binding IsConnected}" />
            <CheckBox DockPanel.Dock="Right" Content="{svc:T Traffic chart}" IsChecked="{Binding ShowChart}" Margin="0,0,16,0" VerticalAlignment="Center" />
            <TextBlock DockPanel.Dock="Right" Text="{Binding Activity.TotalsText}" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedText}" />
        </DockPanel>

        <!-- Chart -->
        <Border DockPanel.Dock="Bottom" Margin="8,0,8,0" Height="170"
                Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="6" Padding="10,6"
                Visibility="{Binding ShowChart, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                    <TextBlock Text="{Binding ChartTitle}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Rectangle Width="12" Height="3" Fill="{DynamicResource ChartInBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Download" Margin="4,0,12,0" Foreground="{DynamicResource MutedText}" />
                        <Rectangle Width="12" Height="3" Fill="{DynamicResource ChartOutBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Upload" Margin="4,0,12,0" Foreground="{DynamicResource MutedText}" />
                        <ComboBox ItemsSource="{Binding ChartWindows}" SelectedItem="{Binding ChartWindowSeconds}" Width="70"
                                  ItemStringFormat="{}{0} s" />
                    </StackPanel>
                </DockPanel>
                <charts:TrafficChart x:Name="Chart" History="{Binding ChartHistory}" ChartStyle="{Binding AppSettings.ChartStyle}"
                                     WindowSeconds="{Binding ChartWindowSeconds}" Units="{Binding Activity.Units}"
                                     InBrush="{DynamicResource ChartInBrush}" OutBrush="{DynamicResource ChartOutBrush}"
                                     GridBrush="{DynamicResource ChartGridBrush}" LabelBrush="{DynamicResource MutedText}" />
            </DockPanel>
        </Border>

        <!-- Main area: activity grid and info pane -->
        <Grid x:Name="ActivityArea" Margin="8,10,8,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="360" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="320" MinWidth="240" />
            </Grid.ColumnDefinitions>

            <DataGrid x:Name="ActivityGrid" Grid.Column="0" ItemsSource="{Binding Activity.Rows}"
                      SelectedItem="{Binding SelectedRow}"
                      AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                      HeadersVisibility="Column" GridLinesVisibility="None" RowHeight="24"
                      CanUserReorderColumns="True" CanUserResizeRows="False"
                      Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}"
                      RowBackground="{DynamicResource PanelBackground}" AlternatingRowBackground="{DynamicResource AltRowBackground}"
                      EnableRowVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling"
                      Sorting="ActivityGrid_Sorting" MouseDoubleClick="ActivityGrid_MouseDoubleClick">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="ContextMenu" Value="{StaticResource RowMenu}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource DimText}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsApp}" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource MutedText}" />
                                <Setter Property="FontSize" Value="12" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Name" Width="*" SortMemberPath="Name" MinWidth="180">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type vm:ActivityRow}">
                                <StackPanel Orientation="Horizontal" ToolTip="{Binding Detail}">
                                    <Border Width="{Binding Indent}" />
                                    <!-- UpdateSourceTrigger must be explicit: DataGrid otherwise defers cell
                                         bindings to its row BindingGroup, which a read-only grid never commits. -->
                                    <ToggleButton Width="16" Height="16" Margin="2,0" Padding="0" BorderThickness="0"
                                                  Background="Transparent" Focusable="False"
                                                  IsChecked="{Binding IsExpanded, UpdateSourceTrigger=PropertyChanged}">
                                        <ToggleButton.Style>
                                            <Style TargetType="ToggleButton">
                                                <Setter Property="Visibility" Value="Hidden" />
                                                <Setter Property="Foreground" Value="{DynamicResource MutedText}" />
                                                <Setter Property="Content" Value="▸" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasChildren}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsApp}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter Property="Content" Value="▾" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ToggleButton.Style>
                                    </ToggleButton>
                                    <Image Source="{Binding Icon}" Width="16" Height="16" Margin="2,0,6,0"
                                           Visibility="{Binding IsApp, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="DL Rate" Width="88" MinWidth="88" SortMemberPath="RateIn" Binding="{Binding RateInText}"
                                        ElementStyle="{StaticResource NumberCell}" />
                    <DataGridTextColumn Header="UL Rate" Width="88" MinWidth="88" SortMemberPath="RateOut" Binding="{Binding RateOutText}"
                                        ElementStyle="{StaticResource NumberCell}" />
                    <DataGridTextColumn Header="DL Total" Width="92" MinWidth="92" SortMemberPath="TotalIn" Binding="{Binding TotalInText}"
                                        ElementStyle="{StaticResource NumberCell}" />
                    <DataGridTextColumn Header="UL Total" Width="92" MinWidth="92" SortMemberPath="TotalOut" Binding="{Binding TotalOutText}"
                                        ElementStyle="{StaticResource NumberCell}" />
                    <DataGridTextColumn Header="Rules" Binding="{Binding RuleStatus}" Width="150" MinWidth="60" CanUserSort="False" />
                </DataGrid.Columns>
            </DataGrid>

            <!-- Shown over the empty grid when not connected -->
            <TextBlock Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                       MaxWidth="420" TextAlignment="Center" Foreground="{DynamicResource BadBrush}" Text="{Binding StatusText}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <GridSplitter x:Name="InspectorSplitter" Grid.Column="1" Width="8" HorizontalAlignment="Center" Background="Transparent" DragCompleted="InspectorSplitter_DragCompleted" />

            <Border x:Name="InspectorPane" Grid.Column="2" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="14,12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding Info.Title}" FontFamily="{StaticResource DisplayFont}" FontSize="16"
                               TextWrapping="Wrap" Margin="0,0,0,10" />
                    <!-- What applies to the selected app, and changing it -->
                    <StackPanel x:Name="Inspector" DockPanel.Dock="Top" DataContext="{Binding SelectedRow}" Margin="0,0,0,10"
                                Visibility="{Binding IsApp, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{svc:T Block incoming}" VerticalAlignment="Center" Margin="0,4,12,4" />
                            <CheckBox Grid.Column="1" Tag="In" IsChecked="{Binding IsBlockedIn, Mode=OneWay}" Click="QuickBlock_Click" ToolTip="Block incoming connections of this app" />
                            <TextBlock Grid.Row="1" Text="{svc:T Block outgoing}" VerticalAlignment="Center" Margin="0,4,12,4" />
                            <CheckBox Grid.Row="1" Grid.Column="1" Tag="Out" IsChecked="{Binding IsBlockedOut, Mode=OneWay}" Click="QuickBlock_Click" ToolTip="Block outgoing connections of this app" />
                            <TextBlock Grid.Row="2" Text="{svc:T Download limit}" VerticalAlignment="Center" Margin="0,4,12,4" />
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" ToolTip="Limit the download speed of this app. Type a value and press Enter.">
                                <CheckBox VerticalAlignment="Center" Tag="In" IsChecked="{Binding IsLimitedIn, Mode=OneWay}" Click="QuickLimit_Click" />
                                <TextBox Tag="In" Text="{Binding LimitInText, Mode=OneWay}" Style="{StaticResource LimitBox}" KeyDown="LimitBox_KeyDown" LostKeyboardFocus="LimitBox_LostFocus" />
                                <TextBlock Text="KB/s" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedText}" />
                            </StackPanel>
                            <TextBlock Grid.Row="3" Text="{svc:T Upload limit}" VerticalAlignment="Center" Margin="0,4,12,4" />
                            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" ToolTip="Limit the upload speed of this app. Type a value and press Enter.">
                                <CheckBox VerticalAlignment="Center" Tag="Out" IsChecked="{Binding IsLimitedOut, Mode=OneWay}" Click="QuickLimit_Click" />
                                <TextBox Tag="Out" Text="{Binding LimitOutText, Mode=OneWay}" Style="{StaticResource LimitBox}" KeyDown="LimitBox_KeyDown" LostKeyboardFocus="LimitBox_LostFocus" />
                                <TextBlock Text="KB/s" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedText}" />
                            </StackPanel>
                            <TextBlock Grid.Row="4" Text="{svc:T Priority}" VerticalAlignment="Center" Margin="0,4,12,4" />
                            <ComboBox Grid.Row="4" Grid.Column="1" Width="110" HorizontalAlignment="Left" Margin="0,2"
                                      ItemsSource="{Binding Data.PriorityLevels, Source={StaticResource Proxy}}"
                                      SelectedItem="{Binding Priority, Mode=OneWay}" SelectionChanged="QuickPriority_Changed"
                                      ToolTip="Priority of this app's traffic. Normal is the default." />
                        </Grid>
                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="{svc:T Add rule...}" Margin="0,0,6,6" Click="AddRuleForRow_Click" />
                            <Button Content="{svc:T Connection history}" Margin="0,0,6,6" Click="ShowHistory_Click" />
                            <Button Content="{svc:T Kill connections}" Margin="0,0,6,6" Click="Kill_Click" />
                            <Button Content="{svc:T Hide app}" Margin="0,0,6,6" Click="Hide_Click" />
                            <Button Content="{svc:T Check with VirusTotal}" Margin="0,0,6,6" Click="VirusTotal_Click" ToolTip="Sends only the file's hash, never the file" />
                        </WrapPanel>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Info.LookupAddress}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Image Source="{Binding Info.FlagCode, Converter={StaticResource FlagImage}}" Width="20" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <Button Content="WHOIS" Padding="8,2" Click="Whois_Click" ToolTip="Asks the public WHOIS servers about this address" />
                        <Button Content="Web" Padding="8,2" Margin="6,0,0,0" Click="AskWeb_Click" ToolTip="Opens this address on ipinfo.io in your browser" />
                        <Button Content="Map" Padding="8,2" Margin="6,0,0,0" Click="ShowMap_Click" ToolTip="Opens the country on OpenStreetMap in your browser" />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Info.Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:InfoItem}">
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="{Binding Label}" Foreground="{DynamicResource MutedText}" FontSize="11" />
                                        <TextBox Text="{Binding Value, Mode=OneWay}" IsReadOnly="True" BorderThickness="0"
                                                 Background="Transparent" TextWrapping="Wrap" Padding="0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
        </DockPanel>
        </TabItem>

        <!-- Blocker -->
        <TabItem Header="Blocker">
            <DockPanel Margin="8">
                <Border DockPanel.Dock="Top" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,10" IsEnabled="{Binding IsConnected}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox Content="Blocker enabled" IsChecked="{Binding IsBlockerEnabled}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Text="Unmatched incoming:" Margin="28,0,6,0" VerticalAlignment="Center" />
                            <ComboBox Width="80" ItemsSource="{Binding FirewallActions}" SelectedItem="{Binding DefaultFirewallIn}"
                                      ToolTip="What happens to incoming connections no blocker rule matches" />
                            <TextBlock Text="Unmatched outgoing:" Margin="20,0,6,0" VerticalAlignment="Center" />
                            <ComboBox Width="80" ItemsSource="{Binding FirewallActions}" SelectedItem="{Binding DefaultFirewallOut}"
                                      ToolTip="What happens to outgoing connections no blocker rule matches. Ask shows a prompt." />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="Quick zone blocker:" VerticalAlignment="Center" Foreground="{DynamicResource MutedText}" />
                            <CheckBox Content="Block Internet in" IsChecked="{Binding BlockInternetIn}" Margin="12,0,0,0" />
                            <CheckBox Content="Block Internet out" IsChecked="{Binding BlockInternetOut}" Margin="12,0,0,0" />
                            <CheckBox Content="Block local network in" IsChecked="{Binding BlockLocalIn}" Margin="24,0,0,0" />
                            <CheckBox Content="Block local network out" IsChecked="{Binding BlockLocalOut}" Margin="12,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding Blocker.StatusText}" Margin="0,10,0,0" Foreground="{DynamicResource MutedText}" />
                        <TextBlock Text="{Binding Blocker.LastError}" Foreground="{DynamicResource BadBrush}" />
                    </StackPanel>
                </Border>
                <TextBlock DockPanel.Dock="Top" Text="Pending blocker requests" FontWeight="SemiBold" Margin="2,0,0,6" />
                <TextBlock DockPanel.Dock="Bottom" Margin="2,8,0,0" Foreground="{DynamicResource MutedText}"
                           Text="Blocker rules are listed in Rules. To block one app, select it in Activity." />
                <DataGrid x:Name="PendingGrid" ItemsSource="{Binding Blocker.Pending}" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="None" RowHeight="28" SelectionMode="Single"
                          Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Application" Binding="{Binding App.DisplayName}" Width="200" />
                        <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="80" />
                        <DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="80" />
                        <DataGridTextColumn Header="Remote" Binding="{Binding RemoteAddress}" Width="160" />
                        <DataGridTextColumn Header="Port" Binding="{Binding RemotePort}" Width="60" />
                        <DataGridTextColumn Header="Host" Binding="{Binding RemoteHost}" Width="*" />
                        <DataGridTemplateColumn Header="" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Allow" Padding="10,1" Click="PendingAllow_Click" />
                                        <Button Content="Deny" Padding="10,1" Margin="6,0,0,0" Click="PendingDeny_Click" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </TabItem>

        <!-- Priorities -->
        <TabItem x:Name="PrioritiesTab" Header="Priorities">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="8" DataContext="{Binding Priorities}" MaxWidth="900" HorizontalAlignment="Left">
                    <Border Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,10"
                            IsEnabled="{Binding DataContext.IsConnected, RelativeSource={RelativeSource AncestorType=Window}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox Content="Priorities enabled" FontWeight="SemiBold" VerticalAlignment="Center"
                                          IsChecked="{Binding DataContext.IsPriorityEnabled, RelativeSource={RelativeSource AncestorType=Window}}" />
                                <TextBlock Text="Reaction speed:" Margin="28,0,6,0" VerticalAlignment="Center" />
                                <ComboBox Width="96" ItemsSource="{Binding ReactionSpeeds}" SelectedItem="{Binding ReactionSpeed}"
                                          ToolTip="How quickly lower priorities are restricted when a higher one starts, and released when it stops. Low = 1 s, Normal = 250 ms, Fast = 100 ms." />
                                <TextBox Width="60" Margin="8,0,4,0" VerticalAlignment="Center" Text="{Binding ReactionMillis}"
                                         Visibility="{Binding IsCustomReaction, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Text="ms" VerticalAlignment="Center" Visibility="{Binding IsCustomReaction, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                            <CheckBox Content="Adaptive allocation: reserve bandwidth for a priority only while it has traffic" Margin="0,10,0,0"
                                      IsChecked="{Binding Adaptive}"
                                      ToolTip="Off: a priority keeps its reservation while it has open connections, even idle ones (steadier for some games, but wastes bandwidth)." />
                            <TextBlock Text="{Binding StateText}" Margin="0,10,0,0" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding InputError}" Foreground="{DynamicResource BadBrush}" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Now" FontWeight="SemiBold" Margin="2,0,0,6" />
                    <DataGrid x:Name="PriorityLevelsGrid" ItemsSource="{Binding Levels}" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="None" RowHeight="26" SelectionMode="Single"
                              Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}"
                              CanUserSortColumns="False" HorizontalAlignment="Left">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Foreground" Value="{DynamicResource DimText}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Priority" Binding="{Binding Level}" Width="100" />
                            <DataGridTextColumn Header="Reserved" Binding="{Binding Reserved}" Width="90" />
                            <DataGridTextColumn Header="DL rate" Binding="{Binding DownloadRate}" Width="110" />
                            <DataGridTextColumn Header="DL allowed" Binding="{Binding DownloadCap}" Width="110" />
                            <DataGridTextColumn Header="UL rate" Binding="{Binding UploadRate}" Width="110" />
                            <DataGridTextColumn Header="UL allowed" Binding="{Binding UploadCap}" Width="110" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Margin="2,8,0,14" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap"
                               Text="To give an app a priority, select it in Activity. For any other filter, add a Priority rule in Rules. Empty 'allowed' means not restricted." />
                    <TextBlock Text="Bandwidth reservation" FontWeight="SemiBold" Margin="2,0,0,6" />
                    <Border Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,10"
                            IsEnabled="{Binding DataContext.IsConnected, RelativeSource={RelativeSource AncestorType=Window}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="56" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                            </Grid.RowDefinitions>
                            <Grid.Resources>
                                <Style TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
                                    <Setter Property="Minimum" Value="0" />
                                    <Setter Property="Maximum" Value="95" />
                                    <Setter Property="TickFrequency" Value="5" />
                                    <Setter Property="IsSnapToTickEnabled" Value="True" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="Margin" Value="0,4" />
                                </Style>
                            </Grid.Resources>
                            <TextBlock Text="Critical" VerticalAlignment="Center" Margin="0,0,16,0"
                                       ToolTip="Share of the line kept for Critical traffic (VoIP, games) while it is active" />
                            <Slider Grid.Column="1" Value="{Binding CriticalPercent, Delay=400}" />
                            <TextBlock Grid.Column="2" Text="{Binding CriticalPercent, StringFormat={}{0} %}" VerticalAlignment="Center" HorizontalAlignment="Right" />

                            <TextBlock Grid.Row="1" Text="High" VerticalAlignment="Center" Margin="0,0,16,0"
                                       ToolTip="Share of the line kept for High traffic (e.g. a browser) while it is active" />
                            <Slider Grid.Row="1" Grid.Column="1" Value="{Binding HighPercent, Delay=400}" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding HighPercent, StringFormat={}{0} %}" VerticalAlignment="Center" HorizontalAlignment="Right" />

                            <TextBlock Grid.Row="2" Text="Normal" VerticalAlignment="Center" Margin="0,0,16,0"
                                       ToolTip="Share of the line kept for Normal traffic (every app without a priority) while it is active; Low traffic gets the rest" />
                            <Slider Grid.Row="2" Grid.Column="1" Value="{Binding NormalPercent, Delay=400}" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding NormalPercent, StringFormat={}{0} %}" VerticalAlignment="Center" HorizontalAlignment="Right" />

                            <TextBlock Grid.Row="3" Text="Headroom" VerticalAlignment="Center" Margin="0,0,16,0"
                                       ToolTip="Extra room over a priority's current speed, so it can speed up before lower priorities yield" />
                            <Slider Grid.Row="3" Grid.Column="1" Value="{Binding HeadroomPercent, Delay=400}" Maximum="100" />
                            <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding HeadroomPercent, StringFormat={}{0} %}" VerticalAlignment="Center" HorizontalAlignment="Right" />

                            <TextBlock Grid.Row="4" Grid.ColumnSpan="3" Margin="0,8,0,0" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap"
                                       Text="The highest priority with traffic always gets what it needs. Each lower priority gets the line minus the reservations of the active priorities above it." />
                        </Grid>
                    </Border>

                    <TextBlock Text="Line speed (KB/s, empty = detect automatically)" FontWeight="SemiBold" Margin="2,0,0,6" />
                    <Border Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,10"
                            IsEnabled="{Binding DataContext.IsConnected, RelativeSource={RelativeSource AncestorType=Window}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Download min" VerticalAlignment="Center" Width="96" />
                                <TextBox x:Name="MinDownloadBox" Width="90" Text="{Binding MinDownload}" KeyDown="SettingBox_KeyDown" />
                                <TextBlock Text="max" VerticalAlignment="Center" Margin="16,0,8,0" />
                                <TextBox Width="90" Text="{Binding MaxDownload}" KeyDown="SettingBox_KeyDown" />
                                <TextBlock Text="Upload min" VerticalAlignment="Center" Margin="32,0,0,0" Width="80" />
                                <TextBox Width="90" Text="{Binding MinUpload}" KeyDown="SettingBox_KeyDown" />
                                <TextBlock Text="max" VerticalAlignment="Center" Margin="16,0,8,0" />
                                <TextBox Width="90" Text="{Binding MaxUpload}" KeyDown="SettingBox_KeyDown" />
                            </StackPanel>
                            <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap"
                                       Text="NetWarden learns the line speed from the fastest traffic it sees. Setting max to your real line speed makes priorities react before the line is full." />
                            <TextBlock Text="{Binding CapacityText}" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- Quotas -->
        <TabItem x:Name="QuotasTab" Header="Quotas">
            <DockPanel Margin="8">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8" IsEnabled="{Binding IsConnected}">
                    <Button Content="{svc:T Add quota}" Style="{StaticResource PrimaryButton}" Click="AddQuota_Click" />
                    <Button Content="Edit" Padding="10,3" Margin="8,0,0,0" Click="EditQuota_Click" />
                    <Button Content="Reset" Padding="10,3" Margin="24,0,0,0" Command="{Binding Quotas.ResetCommand}" CommandParameter="{Binding Quotas.Selected}"
                            ToolTip="Put the counter back to zero and end the overflow" />
                    <Button Content="Init from statistics" Padding="10,3" Margin="8,0,0,0" Command="{Binding Quotas.InitFromStatsCommand}" CommandParameter="{Binding Quotas.Selected}"
                            ToolTip="Set the counter to what the statistics recorded since the last reset" />
                    <TextBlock Text="{Binding Quotas.LastError}" Foreground="{DynamicResource BadBrush}" Margin="16,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <DataGrid x:Name="QuotasGrid" ItemsSource="{Binding Quotas.Rows}" SelectedItem="{Binding Quotas.Selected}"
                          AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column"
                          GridLinesVisibility="None" RowHeight="26" Background="{DynamicResource PanelBackground}"
                          BorderBrush="{DynamicResource BorderBrush}" MouseDoubleClick="QuotasGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="For" Binding="{Binding Name}" Width="*" MinWidth="160" />
                        <DataGridTextColumn Header="Dir" Binding="{Binding Direction}" Width="55" MinWidth="55" />
                        <DataGridTextColumn Header="Used" Binding="{Binding Used}" Width="90" MinWidth="70" ElementStyle="{StaticResource NumberCell}" />
                        <DataGridTextColumn Header="Quota" Binding="{Binding Limit}" Width="90" MinWidth="70" ElementStyle="{StaticResource NumberCell}" />
                        <DataGridTemplateColumn Header="Share" Width="130" MinWidth="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ProgressBar Value="{Binding Share, Mode=OneWay}" Maximum="1" Height="6" Margin="6,0" VerticalAlignment="Center"
                                                 Foreground="{DynamicResource ChartInBrush}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="State" Binding="{Binding State}" Width="85" MinWidth="70" />
                        <DataGridTextColumn Header="Exceeded at" Binding="{Binding ExceededAt}" Width="130" MinWidth="80" />
                        <DataGridTextColumn Header="Next reset" Binding="{Binding NextReset}" Width="130" MinWidth="80" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </TabItem>

        <!-- Statistics -->
        <TabItem x:Name="StatsTab" Header="Statistics">
            <DockPanel Margin="8" DataContext="{Binding Stats}">
                <!-- Time range -->
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6" LastChildFill="False">
                    <ComboBox Width="96" ItemsSource="{Binding Ranges}" SelectedItem="{Binding Range}" />
                    <Button Content="◀" Padding="8,3" Margin="8,0,0,0" Command="{Binding PreviousCommand}"
                            IsEnabled="{Binding CanStep}" ToolTip="Previous period" />
                    <Button Content="▶" Padding="8,3" Margin="4,0,0,0" Command="{Binding NextCommand}"
                            IsEnabled="{Binding CanGoForward}" ToolTip="Next period" />
                    <StackPanel Orientation="Horizontal" Margin="8,0,0,0" Visibility="{Binding IsCustom, Converter={StaticResource BoolToVis}}">
                        <DatePicker SelectedDate="{Binding CustomFrom}" Width="130" />
                        <TextBlock Text="to" Margin="6,0" VerticalAlignment="Center" />
                        <DatePicker SelectedDate="{Binding CustomTo}" Width="130" />
                    </StackPanel>
                    <TextBlock Text="{Binding RangeTitle}" FontWeight="SemiBold" FontSize="14" Margin="14,0,0,0" VerticalAlignment="Center" />
                    <Menu DockPanel.Dock="Right" VerticalAlignment="Center" Background="Transparent" Margin="8,0,0,0">
                        <MenuItem Header="Export ▾" Padding="6,3">
                            <MenuItem Header="Breakdown as CSV..." Click="StatsExportRows_Click" />
                            <MenuItem Header="Time chart as CSV..." Click="StatsExportSeries_Click" />
                        </MenuItem>
                    </Menu>
                    <Button DockPanel.Dock="Right" Content="Refresh" Padding="10,3" Command="{Binding RefreshCommand}"
                            IsEnabled="{Binding DataContext.IsConnected, RelativeSource={RelativeSource AncestorType=Window}}" />
                </DockPanel>

                <!-- Filters -->
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="False">
                    <TextBlock Text="Zones:" VerticalAlignment="Center" Foreground="{DynamicResource MutedText}" />
                    <CheckBox Content="Internet" IsChecked="{Binding ShowInternet}" Margin="8,0,0,0" />
                    <CheckBox Content="Local network" IsChecked="{Binding ShowLocalNetwork}" Margin="12,0,0,0" />
                    <CheckBox Content="Loopback" IsChecked="{Binding ShowLoopback}" Margin="12,0,0,0" />
                    <TextBlock Text="Protocol:" Margin="20,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedText}" />
                    <ComboBox Width="70" ItemsSource="{Binding Protocols}" SelectedItem="{Binding Protocol}" />
                    <TextBlock Text="Network:" Margin="20,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedText}" />
                    <ComboBox Width="140" ItemsSource="{Binding Networks}" SelectedItem="{Binding Network}" DisplayMemberPath="Name" />
                    <Border Margin="16,0,0,0" Padding="8,2,4,2" CornerRadius="10" Background="{DynamicResource SelectionBackground}"
                            Visibility="{Binding HasAppFilter, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding AppFilterText}" VerticalAlignment="Center" />
                            <Button Content="✕" Padding="5,0" Margin="6,0,0,0" Command="{Binding ClearAppFilterCommand}"
                                    Background="Transparent" BorderThickness="0" ToolTip="Show all apps" />
                        </StackPanel>
                    </Border>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding TotalsText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding LastError}" Foreground="{DynamicResource BadBrush}"
                               Margin="0,0,16,0" VerticalAlignment="Center" />
                </DockPanel>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="200" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="320" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Time chart -->
                    <Border Grid.ColumnSpan="2" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,8">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top">
                                <TextBlock Text="Transferred" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Rectangle Width="10" Height="10" Fill="{DynamicResource ChartInBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="Download" Margin="4,0,12,0" Foreground="{DynamicResource MutedText}" />
                                    <Rectangle Width="10" Height="10" Fill="{DynamicResource ChartOutBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="Upload" Margin="4,0,0,0" Foreground="{DynamicResource MutedText}" />
                                </StackPanel>
                            </DockPanel>
                            <charts:StatsChart x:Name="StatsTimeChart" Bars="{Binding Bars}"
                                               InBrush="{DynamicResource ChartInBrush}" OutBrush="{DynamicResource ChartOutBrush}"
                                               GridBrush="{DynamicResource ChartGridBrush}" LabelBrush="{DynamicResource MutedText}"
                                               HighlightBrush="{DynamicResource SelectionBackground}" />
                        </DockPanel>
                    </Border>

                    <!-- Breakdown -->
                    <DockPanel Grid.Row="1">
                        <DockPanel DockPanel.Dock="Top" Margin="2,0,0,6">
                            <TextBlock Text="By" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <ComboBox Width="90" Margin="8,0,0,0" ItemsSource="{Binding GroupBys}" SelectedItem="{Binding GroupBy}" />
                            <TextBlock Text="{Binding FooterText}" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedText}" />
                            <TextBlock Text="Double-click an app to see its hosts" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Foreground="{DynamicResource DimText}" />
                        </DockPanel>
                        <DataGrid x:Name="StatsGrid" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True"
                                  SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="None" RowHeight="24"
                                  Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}"
                                  AlternatingRowBackground="{DynamicResource AltRowBackground}"
                                  MouseDoubleClick="StatsGrid_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Label}" Width="*" MinWidth="160" />
                                <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="230" MinWidth="80" />
                                <DataGridTextColumn Header="Download" Binding="{Binding In}" SortMemberPath="Row.In" Width="95" MinWidth="70"
                                                    ElementStyle="{StaticResource NumberCell}" />
                                <DataGridTextColumn Header="Upload" Binding="{Binding Out}" SortMemberPath="Row.Out" Width="95" MinWidth="70"
                                                    ElementStyle="{StaticResource NumberCell}" />
                                <DataGridTextColumn Header="Total" Binding="{Binding Total}" SortMemberPath="TotalBytes" Width="95" MinWidth="70"
                                                    ElementStyle="{StaticResource NumberCell}" />
                                <DataGridTemplateColumn Header="Share" SortMemberPath="TotalBytes" Width="90" MinWidth="60">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ProgressBar Value="{Binding Share, Mode=OneWay}" Maximum="1" Height="6" Margin="6,0"
                                                         VerticalAlignment="Center" Foreground="{DynamicResource ChartInBrush}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>

                    <!-- Time of day: fills the row up to 260 px, top-aligned -->
                    <Grid Grid.Row="1" Grid.Column="1" Width="380" Margin="8,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" MaxHeight="260" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                    <Border Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="10,6">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="By hour of day" FontWeight="SemiBold" />
                            <charts:StatsChart x:Name="StatsHourChart" Bars="{Binding HourBars}"
                                               InBrush="{DynamicResource ChartInBrush}" OutBrush="{DynamicResource ChartOutBrush}"
                                               GridBrush="{DynamicResource ChartGridBrush}" LabelBrush="{DynamicResource MutedText}"
                                               HighlightBrush="{DynamicResource SelectionBackground}" />
                        </DockPanel>
                    </Border>
                    </Grid>
                </Grid>
            </DockPanel>
        </TabItem>

        <!-- Apps -->
        <TabItem x:Name="AppsTab" Header="Apps">
            <DockPanel Margin="8" DataContext="{Binding Apps}">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="False">
                    <ComboBox Width="110" ItemsSource="{Binding Availabilities}" SelectedItem="{Binding Availability}" />
                    <TextBox Width="220" Margin="12,0,0,0" VerticalContentAlignment="Center"
                             Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search names, paths and tags" />
                    <Button Content="Delete..." Padding="10,3" Margin="12,0,0,0" Click="DeleteApp_Click" />
                    <TextBlock Text="Tags:" Margin="24,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedText}" />
                    <TextBox Width="190" VerticalContentAlignment="Center" Text="{Binding TagsText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Tags of the selected app, separated by commas" />
                    <Button Content="Save tags" Padding="10,3" Margin="6,0,0,0" Command="{Binding SaveTagsCommand}" />
                    <ComboBox Width="120" Margin="24,0,0,0" ItemsSource="{Binding AllTags}" SelectedItem="{Binding SelectedTag}" ToolTip="A tag in use" />
                    <Button Content="Add rule for tag" Padding="10,3" Margin="6,0,0,0" Click="AddRuleForTag_Click" />
                    <TextBlock Text="{Binding LastError}" Foreground="{DynamicResource BadBrush}" Margin="16,0,0,0" VerticalAlignment="Center" />
                </DockPanel>
                <DataGrid x:Name="AppsGrid" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="None" RowHeight="24"
                          Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}"
                          AlternatingRowBackground="{DynamicResource AltRowBackground}" EnableRowVirtualization="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="220" />
                        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="110" />
                        <DataGridTextColumn Header="Availability" Binding="{Binding Availability}" Width="90" />
                        <DataGridTextColumn Header="Tags" Binding="{Binding Tags}" Width="150" />
                        <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="*" MinWidth="200" />
                        <DataGridTextColumn Header="First seen" Binding="{Binding FirstSeen}" SortMemberPath="App.FirstSeen" Width="130" />
                        <DataGridTextColumn Header="Last seen" Binding="{Binding LastSeen}" SortMemberPath="App.LastSeen" Width="130" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </TabItem>

        <!-- Networks -->
        <TabItem x:Name="NetworksTab" Header="Networks">
            <DockPanel Margin="8" DataContext="{Binding Networks}">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="Add rule for network" Padding="10,3" Click="AddRuleForNetwork_Click" />
                    <Button Content="Delete" Padding="10,3" Margin="8,0,0,0" Command="{Binding DeleteCommand}" CommandParameter="{Binding Selected}"
                            ToolTip="Forget a network that isn't in use" />
                    <TextBlock Text="{Binding LastError}" Foreground="{DynamicResource BadBrush}" Margin="16,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <DataGrid x:Name="NetworksGrid" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="None" RowHeight="24"
                          Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}"
                          AlternatingRowBackground="{DynamicResource AltRowBackground}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="200" />
                        <DataGridTextColumn Header="State" Binding="{Binding Active}" Width="70" />
                        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="70" />
                        <DataGridTextColumn Header="Interface" Binding="{Binding Interface}" Width="*" MinWidth="180" />
                        <DataGridTextColumn Header="Gateway MAC" Binding="{Binding Gateway}" Width="150" />
                        <DataGridTextColumn Header="First seen" Binding="{Binding FirstSeen}" SortMemberPath="Network.FirstSeen" Width="130" />
                        <DataGridTextColumn Header="Last seen" Binding="{Binding LastSeen}" SortMemberPath="Network.LastSeen" Width="130" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </TabItem>

        <!-- Connection log -->
        <TabItem x:Name="LogTab" Header="Log">
            <DockPanel Margin="8" DataContext="{Binding Log}">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="False">
                    <Button Content="{Binding ToggleText}" Width="70" Padding="0,3" Command="{Binding ToggleRunningCommand}" />
                    <Button Content="Clear" Padding="10,3" Margin="8,0,0,0" Command="{Binding ClearCommand}" />
                    <TextBox Width="240" Margin="12,0,0,0" VerticalContentAlignment="Center"
                             Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search apps, addresses, hosts and events" />
                    <TextBlock Text="{Binding LastError}" Foreground="{DynamicResource BadBrush}" Margin="16,0,0,0" VerticalAlignment="Center" />
                    <Button DockPanel.Dock="Right" Content="Export CSV..." Padding="10,3" Click="LogExport_Click" />
                </DockPanel>
                <DataGrid x:Name="LogGrid" ItemsSource="{Binding Entries}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                          HeadersVisibility="Column" GridLinesVisibility="None" RowHeight="22" Background="{DynamicResource PanelBackground}"
                          BorderBrush="{DynamicResource BorderBrush}" AlternatingRowBackground="{DynamicResource AltRowBackground}"
                          EnableRowVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="80" />
                        <DataGridTextColumn Header="Event" Binding="{Binding Event}" Width="75" />
                        <DataGridTextColumn Header="App" Binding="{Binding App}" Width="*" MinWidth="150" />
                        <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="60" />
                        <DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="70" />
                        <DataGridTextColumn Header="Local" Binding="{Binding Local}" Width="170" />
                        <DataGridTextColumn Header="Remote" Binding="{Binding Remote}" Width="170" />
                        <DataGridTextColumn Header="Host" Binding="{Binding Host}" Width="220" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </TabItem>

        <!-- Connection history -->
        <TabItem x:Name="HistoryTab" Header="History">
            <DockPanel Margin="8" DataContext="{Binding History}">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="False">
                    <ComboBox Width="90" ItemsSource="{Binding Ranges}" SelectedItem="{Binding Range}" />
                    <TextBox Width="240" Margin="12,0,0,0" VerticalContentAlignment="Center"
                             Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search apps, addresses, hosts and ports" />
                    <Border Margin="12,0,0,0" Padding="8,2,4,2" CornerRadius="10" Background="{DynamicResource SelectionBackground}"
                            Visibility="{Binding HasApp, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding AppText}" VerticalAlignment="Center" />
                            <Button Content="✕" Padding="5,0" Margin="6,0,0,0" Command="{Binding ClearAppCommand}"
                                    Background="Transparent" BorderThickness="0" ToolTip="Show all apps" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding LastError}" Foreground="{DynamicResource BadBrush}" Margin="16,0,0,0" VerticalAlignment="Center" />
                    <Button DockPanel.Dock="Right" Content="Export CSV..." Padding="10,3" Click="HistoryExport_Click" />
                    <Button DockPanel.Dock="Right" Content="Refresh" Padding="10,3" Margin="0,0,8,0" Command="{Binding RefreshCommand}" />
                </DockPanel>
                <DataGrid x:Name="HistoryGrid" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                          HeadersVisibility="Column" GridLinesVisibility="None" RowHeight="22" Background="{DynamicResource PanelBackground}"
                          BorderBrush="{DynamicResource BorderBrush}" AlternatingRowBackground="{DynamicResource AltRowBackground}"
                          EnableRowVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="App" Binding="{Binding App}" Width="*" MinWidth="150" />
                        <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="150" />
                        <DataGridTextColumn Header="Host" Binding="{Binding Host}" Width="220" />
                        <DataGridTextColumn Header="Port" Binding="{Binding Port}" Width="60" />
                        <DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="70" />
                        <DataGridTextColumn Header="Download" Binding="{Binding In}" SortMemberPath="Row.In" Width="90" ElementStyle="{StaticResource NumberCell}" />
                        <DataGridTextColumn Header="Upload" Binding="{Binding Out}" SortMemberPath="Row.Out" Width="90" ElementStyle="{StaticResource NumberCell}" />
                        <DataGridTextColumn Header="First transfer" Binding="{Binding First}" SortMemberPath="Row.First" Width="130" />
                        <DataGridTextColumn Header="Last transfer" Binding="{Binding Last}" SortMemberPath="Row.Last" Width="130" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </TabItem>

        <!-- Filters -->
        <TabItem Header="Filters">
            <DockPanel Margin="8">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="{svc:T Add filter}" Style="{StaticResource PrimaryButton}" Click="AddFilter_Click" IsEnabled="{Binding IsConnected}" />
                    <Button Content="Edit" Padding="10,3" Margin="8,0,0,0" Click="EditFilter_Click" IsEnabled="{Binding IsConnected}" />
                    <Button Content="Delete" Padding="10,3" Margin="8,0,0,0" Click="DeleteFilter_Click" IsEnabled="{Binding IsConnected}" />
                    <Button Content="Add rule for filter" Padding="10,3" Margin="24,0,0,0" Click="AddRuleForFilter_Click" IsEnabled="{Binding IsConnected}" />
                    <TextBlock Text="{Binding Rules.LastError}" Foreground="{DynamicResource BadBrush}" Margin="16,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <DataGrid x:Name="FiltersGrid" ItemsSource="{Binding Rules.Filters}" SelectedItem="{Binding Rules.SelectedFilter}"
                          AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column"
                          GridLinesVisibility="None" RowHeight="24" Background="{DynamicResource PanelBackground}"
                          BorderBrush="{DynamicResource BorderBrush}" AlternatingRowBackground="{DynamicResource AltRowBackground}"
                          MouseDoubleClick="FiltersGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="220" />
                        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="90" />
                        <DataGridTextColumn Header="Per" Binding="{Binding PerType}" Width="100" />
                        <DataGridTextColumn Header="Rules" Binding="{Binding RuleCount}" Width="60" />
                        <DataGridCheckBoxColumn Header="Predefined" Binding="{Binding IsPredefined, Mode=OneWay}" Width="80" />
                        <DataGridTextColumn Header="Definition" Binding="{Binding Definition}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </TabItem>

        <!-- Rules -->
        <TabItem Header="Rules">
            <DockPanel Margin="8">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <ComboBox Width="110" ItemsSource="{Binding Rules.KindFilters}" SelectedItem="{Binding Rules.KindFilter}" ToolTip="Which type of rule to list" Margin="0,0,12,0" />
                    <Button Content="{svc:T Add rule}" Style="{StaticResource PrimaryButton}" Click="AddRule_Click" IsEnabled="{Binding IsConnected}" />
                    <Button Content="Edit" Padding="10,3" Margin="8,0,0,0" Click="EditRule_Click" IsEnabled="{Binding IsConnected}" />
                    <Button Content="Delete" Padding="10,3" Margin="8,0,0,0" Click="DeleteRule_Click" IsEnabled="{Binding IsConnected}" />
                    <Button Content="Enable / disable" Padding="10,3" Margin="8,0,0,0" IsEnabled="{Binding IsConnected}"
                            Command="{Binding Rules.ToggleEnabledCommand}" CommandParameter="{Binding Rules.SelectedRule}" />
                    <Button Content="Move up" Padding="10,3" Margin="24,0,0,0" IsEnabled="{Binding IsConnected}"
                            Command="{Binding Rules.MoveUpCommand}" CommandParameter="{Binding Rules.SelectedRule}"
                            ToolTip="Among rules of equal weight, the first matching one wins" />
                    <Button Content="Move down" Padding="10,3" Margin="8,0,0,0" IsEnabled="{Binding IsConnected}"
                            Command="{Binding Rules.MoveDownCommand}" CommandParameter="{Binding Rules.SelectedRule}" />
                    <TextBlock Text="{Binding Rules.LastError}" Foreground="{DynamicResource BadBrush}" Margin="16,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <DataGrid x:Name="RulesGrid" ItemsSource="{Binding Rules.VisibleRules}" SelectedItem="{Binding Rules.SelectedRule}"
                          AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column"
                          GridLinesVisibility="None" RowHeight="24" Background="{DynamicResource PanelBackground}"
                          BorderBrush="{DynamicResource BorderBrush}" AlternatingRowBackground="{DynamicResource AltRowBackground}"
                          MouseDoubleClick="RulesGrid_MouseDoubleClick">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                    <Setter Property="Foreground" Value="{DynamicResource DimText}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="On" Binding="{Binding IsEnabled, Mode=OneWay}" Width="40" />
                        <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="80" />
                        <DataGridTextColumn Header="For" Binding="{Binding For}" Width="200" />
                        <DataGridTextColumn Header="Dir" Binding="{Binding Direction}" Width="55" />
                        <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="150" />
                        <DataGridTextColumn Header="Weight" Binding="{Binding Weight}" Width="66" />
                        <DataGridTextColumn Header="State" Binding="{Binding State}" Width="75" />
                        <DataGridTextColumn Header="Expires" Binding="{Binding Expires}" Width="120" />
                        <DataGridTextColumn Header="Schedule" Binding="{Binding Schedule}" Width="220" />
                        <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </TabItem>

        <!-- Settings -->
        <TabItem x:Name="SettingsTab" Header="Settings">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="8" MaxWidth="760" HorizontalAlignment="Left">
                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Text="{svc:T Appearance}" Style="{StaticResource SectionTitle}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock Text="{svc:T Theme}" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" Width="170" HorizontalAlignment="Left" Margin="0,3" ItemsSource="{Binding AppThemes}" SelectedItem="{Binding Theme}" />
                                <TextBlock Grid.Row="1" Text="{svc:T Accent color}" VerticalAlignment="Center" />
                                <ComboBox Grid.Row="1" Grid.Column="1" Width="170" HorizontalAlignment="Left" Margin="0,3" ItemsSource="{Binding AppSettings.Accents}" SelectedItem="{Binding AppSettings.Accent}" />
                                <TextBlock Grid.Row="2" Text="{svc:T Language}" VerticalAlignment="Center" />
                                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,3">
                                    <ComboBox Width="170" ItemsSource="{Binding AppSettings.Languages}" SelectedItem="{Binding AppSettings.Language}" DisplayMemberPath="Name" />
                                    <TextBlock Text="{Binding AppSettings.LanguageNote}" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedText}" />
                                </StackPanel>
                                <TextBlock Grid.Row="3" Text="{svc:T Units}" VerticalAlignment="Center" />
                                <ComboBox Grid.Row="3" Grid.Column="1" Width="170" HorizontalAlignment="Left" Margin="0,3" ItemsSource="{Binding Activity.UnitModes}" SelectedItem="{Binding Activity.Units}" />
                                <TextBlock Grid.Row="4" Text="{svc:T Chart style}" VerticalAlignment="Center" />
                                <ComboBox Grid.Row="4" Grid.Column="1" Width="170" HorizontalAlignment="Left" Margin="0,3" ItemsSource="{Binding AppSettings.ChartStyles}" SelectedItem="{Binding AppSettings.ChartStyle}" />
                                <TextBlock Grid.Row="5" Text="{svc:T Info pane}" VerticalAlignment="Center" />
                                <CheckBox Grid.Row="5" Grid.Column="1" Margin="0,5" IsChecked="{Binding ShowInfoPane}" Content="Show details of the selected app or connection" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Text="{svc:T Behavior}" Style="{StaticResource SectionTitle}" />
                            <CheckBox Content="{svc:T Start NetWarden when I sign in}" IsChecked="{Binding AppSettings.RunOnStartup}" Margin="0,3" />
                            <CheckBox Content="{svc:T Minimize to the notification area}" IsChecked="{Binding AppSettings.MinimizeToTray}" Margin="0,3" />
                            <CheckBox Content="{svc:T Keep running in the notification area when I close the window}" IsChecked="{Binding AppSettings.CloseToTray}" Margin="0,3" />
                            <CheckBox Content="{svc:T Show notifications}" IsChecked="{Binding AppSettings.Notifications}" Margin="0,3"
                                      ToolTip="Tells you about exceeded quotas and connection requests while the window is hidden" />
                            <TextBlock Text="{Binding AppSettings.StartupError}" Foreground="{DynamicResource BadBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Text="{svc:T Hotkeys}" Style="{StaticResource SectionTitle}" />
                            <ItemsControl ItemsSource="{Binding AppSettings.Hotkeys}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,2">
                                            <Button DockPanel.Dock="Right" Content="{svc:T Delete}" Click="RemoveHotkey_Click" />
                                            <TextBlock Text="{Binding Gesture}" Width="150" VerticalAlignment="Center" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Target, Converter={StaticResource HotkeyTargetName}}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBox x:Name="HotkeyBox" Width="140" Text="{Binding AppSettings.NewHotkeyText, UpdateSourceTrigger=PropertyChanged}"
                                         PreviewKeyDown="HotkeyBox_PreviewKeyDown" ToolTip="Press the key combination here" />
                                <ComboBox Width="320" Margin="8,0,0,0" ItemsSource="{Binding AppSettings.HotkeyTargets}" SelectedItem="{Binding AppSettings.NewHotkeyTarget}" DisplayMemberPath="Name" />
                                <Button Content="{svc:T Add}" Margin="8,0,0,0" Command="{Binding AppSettings.AddHotkeyCommand}" />
                            </StackPanel>
                            <TextBlock Text="{Binding AppSettings.HotkeyError}" Foreground="{DynamicResource BadBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Text="{svc:T Layout profiles}" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Saves your columns, sorting and panes under a name, to switch between arrangements." Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <TextBox Width="170" Text="{Binding AppSettings.NewProfileName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Name of the new profile" />
                                <Button Content="Save current layout" Margin="8,0,0,0" Command="{Binding AppSettings.SaveProfileCommand}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <ComboBox Width="170" ItemsSource="{Binding AppSettings.ProfileNames}" SelectedItem="{Binding AppSettings.SelectedProfile}" />
                                <Button Content="Use" Margin="8,0,0,0" Command="{Binding AppSettings.ApplyProfileCommand}" />
                                <Button Content="{svc:T Delete}" Margin="8,0,0,0" Command="{Binding AppSettings.DeleteProfileCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Section}" DataContext="{Binding Stats}"
                            IsEnabled="{Binding DataContext.IsConnected, RelativeSource={RelativeSource AncestorType=Window}}">
                        <StackPanel>
                            <TextBlock Text="{svc:T Statistics}" Style="{StaticResource SectionTitle}" />
                            <CheckBox Content="{svc:T Record statistics}" IsChecked="{Binding IsStatsEnabled}"
                                      ToolTip="Write traffic to the stats database (per minute; older than 2 days per hour)" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,8">
                                <TextBlock Text="Save traffic of:" VerticalAlignment="Center" Foreground="{DynamicResource MutedText}" />
                                <CheckBox Content="Internet" IsChecked="{Binding SaveInternet}" Margin="12,0,0,0" />
                                <CheckBox Content="Local network" IsChecked="{Binding SaveLocalNetwork}" Margin="12,0,0,0" />
                                <CheckBox Content="Loopback" IsChecked="{Binding SaveLoopback}" Margin="12,0,0,0" ToolTip="Traffic between programs on this computer" />
                            </StackPanel>
                            <Button Content="{svc:T Manage database...}" HorizontalAlignment="Left" Click="StatsManager_Click" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Text="{svc:T Manage another computer}" Style="{StaticResource SectionTitle}" />
                            <StackPanel Orientation="Horizontal">
                                <TextBox Width="190" Text="{Binding RemoteConnect.Host, UpdateSourceTrigger=PropertyChanged}" ToolTip="Name or address of the computer" />
                                <TextBox Width="64" Margin="6,0,0,0" Text="{Binding RemoteConnect.Port, UpdateSourceTrigger=PropertyChanged}" ToolTip="Port" />
                                <PasswordBox x:Name="RemotePassword" Width="150" Margin="6,0,0,0" ToolTip="Its remote administration password" />
                                <Button Content="{svc:T Connect}" Margin="6,0,0,0" Click="RemoteConnect_Click" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="{svc:T Use this computer}" Command="{Binding RemoteConnect.UseThisComputerCommand}" />
                                <Button Content="{svc:T Forget its certificate}" Margin="6,0,0,0" Command="{Binding RemoteConnect.ForgetCertificateCommand}"
                                        ToolTip="Only after that computer was reinstalled: the next connection accepts its new certificate" />
                            </StackPanel>
                            <TextBlock Text="{Binding RemoteConnect.StatusText}" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Section}" IsEnabled="{Binding IsConnected}">
                        <StackPanel DataContext="{Binding RemoteAdmin}">
                            <TextBlock Text="{svc:T Let other computers manage this one}" Style="{StaticResource SectionTitle}" />
                            <CheckBox Content="{svc:T Allow remote administration}" IsChecked="{Binding IsEnabled}"
                                      ToolTip="Whoever has the password can change every rule on this computer" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="{svc:T Port}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox Width="70" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="{svc:T New password}" VerticalAlignment="Center" Margin="16,0,8,0" />
                                <PasswordBox x:Name="RemoteNewPassword" Width="170" ToolTip="At least 8 characters. Leave empty to keep the current one." />
                                <Button Content="{svc:T Apply}" Margin="8,0,0,0" Click="RemoteApply_Click" />
                            </StackPanel>
                            <TextBlock Text="{Binding StateText}" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0" />
                            <TextBox Text="{Binding Thumbprint, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" TextWrapping="Wrap" Padding="0" Margin="0,2,0,0"
                                     Foreground="{DynamicResource MutedText}" ToolTip="This computer's certificate. Compare it with what the other computer shows when it first connects." />
                            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource BadBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Section}" IsEnabled="{Binding IsConnected}">
                        <StackPanel DataContext="{Binding Permissions}">
                            <TextBlock Text="{svc:T Permissions}" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Administrators always have access. Add users or groups here to give them full control of NetWarden, or to keep them out."
                                       Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding Entries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,2">
                                            <Button DockPanel.Dock="Right" Content="{svc:T Delete}" Click="PermissionRemove_Click" />
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedText}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="Denied" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsAllowed}" Value="True">
                                                                <Setter Property="Text" Value="Allowed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBox Width="220" Text="{Binding NewAccount, UpdateSourceTrigger=PropertyChanged}" ToolTip="A user or group, for example PC\\alice or Users" />
                                <CheckBox Content="{svc:T Allowed}" IsChecked="{Binding NewIsAllowed}" Margin="10,0,0,0" ToolTip="Leave unchecked to deny. A denied group wins over an allowed one." />
                                <Button Content="{svc:T Add}" Margin="10,0,0,0" Command="{Binding AddCommand}" />
                            </StackPanel>
                            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource BadBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Text="VirusTotal" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="To check an app, select it in Activity. Only the file's hash is sent, and only when you ask. The key is stored encrypted for your Windows account."
                                       Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{svc:T API key}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox Width="420" Text="{Binding AppSettings.VirusTotalKey}" KeyDown="SettingBox_KeyDown" ToolTip="Your own key from virustotal.com" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Section}">
                        <StackPanel>
                            <TextBlock Text="{svc:T About}" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding ServiceSummary}" Foreground="{DynamicResource MutedText}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
            </TabControl>
        </DockPanel>
    </Grid>
</Window>
