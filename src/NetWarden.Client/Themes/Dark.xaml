<!-- Colors of the dark theme. Same keys in both. The rail stays harbour blue-green in either. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WindowBackground" Color="#0F1B1D" />
    <SolidColorBrush x:Key="PanelBackground" Color="#16262A" />
    <SolidColorBrush x:Key="AltRowBackground" Color="#1B2D31" />
    <SolidColorBrush x:Key="BorderBrush" Color="#2A4045" />
    <SolidColorBrush x:Key="TextBrush" Color="#E2ECEB" />
    <SolidColorBrush x:Key="MutedText" Color="#9DB3B3" />
    <SolidColorBrush x:Key="DimText" Color="#6C8285" />
    <SolidColorBrush x:Key="SelectionBackground" Color="#1F4A50" />
    <SolidColorBrush x:Key="AccentBrush" Color="#4FC3C9" />
    <SolidColorBrush x:Key="OkBrush" Color="#4ADE80" />
    <SolidColorBrush x:Key="WarnBrush" Color="#FBBF24" />
    <SolidColorBrush x:Key="BadBrush" Color="#F87171" />
    <SolidColorBrush x:Key="ChartInBrush" Color="#4FC3C9" />
    <SolidColorBrush x:Key="ChartOutBrush" Color="#E77FB3" />
    <SolidColorBrush x:Key="ChartGridBrush" Color="#263A3E" />
    <SolidColorBrush x:Key="RailBackground" Color="#0A2A2E" />
    <SolidColorBrush x:Key="RailText" Color="#E4F0EE" />
    <SolidColorBrush x:Key="RailMuted" Color="#8FAFAD" />
    <SolidColorBrush x:Key="RailHover" Color="#123A3F" />
    <SolidColorBrush x:Key="RailSelected" Color="#17474D" />
    <SolidColorBrush x:Key="SignalBrush" Color="#F2C230" />
    <SolidColorBrush x:Key="RailIn" Color="#6FD6D9" />
    <SolidColorBrush x:Key="RailOut" Color="#F0A0CC" />
</ResourceDictionary>
