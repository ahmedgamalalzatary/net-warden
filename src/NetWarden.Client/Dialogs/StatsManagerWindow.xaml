<Window x:Class="NetWarden.Client.Dialogs.StatsManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:NetWarden.Client.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:StatsManagerViewModel}"
        Title="Stats database" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackground}" FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,4,12,4" />
            <Setter Property="Foreground" Value="{DynamicResource MutedText}" />
        </Style>
        <Style TargetType="Border" x:Key="Panel">
            <Setter Property="Background" Value="{DynamicResource PanelBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </Window.Resources>
    <StackPanel Margin="16">
        <Border Style="{StaticResource Panel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock Text="File" Style="{StaticResource Label}" />
                <TextBlock Grid.Column="1" Text="{Binding PathText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                           ToolTip="{Binding PathText}" />
                <TextBlock Grid.Row="1" Text="Size" Style="{StaticResource Label}" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SizeText}" VerticalAlignment="Center" />
                <TextBlock Grid.Row="2" Text="Contents" Style="{StaticResource Label}" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding RecordsText}" VerticalAlignment="Center" />
                <TextBlock Grid.Row="3" Text="Covers" Style="{StaticResource Label}" />
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding RangeText}" VerticalAlignment="Center" />
                <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Text="{Binding GeoText}" Margin="0,6,0,0" Foreground="{DynamicResource DimText}" />
            </Grid>
        </Border>

        <TextBlock Text="Delete records" FontWeight="SemiBold" Margin="2,0,0,6" />
        <Border Style="{StaticResource Panel}" IsEnabled="{Binding IsIdle}">
            <StackPanel>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock Text="Older than" Style="{StaticResource Label}" Width="80" />
                    <Button x:Name="DeleteOldButton" DockPanel.Dock="Right" Content="Delete" Padding="12,3" Click="DeleteOld_Click" />
                    <DatePicker SelectedDate="{Binding DeleteBefore}" Width="140" HorizontalAlignment="Left" />
                </DockPanel>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock Text="Of app" Style="{StaticResource Label}" Width="80" />
                    <Button DockPanel.Dock="Right" Content="Delete" Padding="12,3" Click="DeleteApp_Click" Margin="8,0,0,0" />
                    <ComboBox ItemsSource="{Binding Apps}" SelectedItem="{Binding SelectedApp}" />
                </DockPanel>
                <DockPanel>
                    <TextBlock Text="Everything" Style="{StaticResource Label}" Width="80" />
                    <Button DockPanel.Dock="Right" Content="Delete all" Padding="12,3" Click="DeleteAll_Click" />
                    <TextBlock />
                </DockPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Panel}" IsEnabled="{Binding IsIdle}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Compact" Padding="12,3" Click="Compact_Click" VerticalAlignment="Center" />
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedText}" Margin="0,0,12,0"
                           Text="Merges minute records older than two days into hours, forgets apps without records and shrinks the file." />
            </DockPanel>
        </Border>

        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="2,0,0,4" />
        <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="{DynamicResource BadBrush}" Margin="2,0,0,4" />
        <Button Content="Close" IsCancel="True" HorizontalAlignment="Right" Padding="16,3" Margin="0,6,0,0" Click="Close_Click" />
    </StackPanel>
</Window>
