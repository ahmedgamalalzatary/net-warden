<Window x:Class="NetWarden.Client.Dialogs.RuleEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:NetWarden.Client.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:RuleEditorViewModel}"
        Title="{Binding Title}" Width="560" SizeToContent="Height" MaxHeight="820" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackground}" FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,6,12,6" />
        </Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="16">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
            </Grid.RowDefinitions>

            <TextBlock Text="For filter" Style="{StaticResource Label}" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter}" DisplayMemberPath="Name" Margin="0,4" />

            <TextBlock Grid.Row="1" Text="Rule type" Style="{StaticResource Label}" />
            <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind}" Margin="0,4" />

            <TextBlock Grid.Row="2" Text="Direction" Style="{StaticResource Label}"
                       ToolTip="Limits: In = download, Out = upload. Blocker: In = incoming connections, Out = outgoing." />
            <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding Directions}" SelectedItem="{Binding Direction}" Margin="0,4" />

            <TextBlock Grid.Row="3" Text="Limit (KB/s)" Style="{StaticResource Label}" Visibility="{Binding IsLimit, Converter={StaticResource BoolToVis}}" />
            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding LimitKilobytes, UpdateSourceTrigger=PropertyChanged}" Margin="0,4" Padding="4,3"
                     Visibility="{Binding IsLimit, Converter={StaticResource BoolToVis}}" />

            <TextBlock Grid.Row="4" Text="Action" Style="{StaticResource Label}" Visibility="{Binding IsFirewall, Converter={StaticResource BoolToVis}}" />
            <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding Actions}" SelectedItem="{Binding Action}" Margin="0,4"
                      Visibility="{Binding IsFirewall, Converter={StaticResource BoolToVis}}" />

            <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,6"
                        Visibility="{Binding IsIgnore, Converter={StaticResource BoolToVis}}">
                <CheckBox Content="Ignore limit" IsChecked="{Binding IgnoreLimit}" Margin="0,0,16,0" />
                <CheckBox Content="Ignore data (not counted in stats)" IsChecked="{Binding IgnoreData}" />
            </StackPanel>

            <TextBlock Grid.Row="6" Text="Priority" Style="{StaticResource Label}" Visibility="{Binding IsPriority, Converter={StaticResource BoolToVis}}"
                       ToolTip="While a higher priority has traffic, lower priorities get only what it leaves over." />
            <ComboBox Grid.Row="6" Grid.Column="1" ItemsSource="{Binding PriorityLevels}" SelectedItem="{Binding Priority}" Margin="0,4"
                      Visibility="{Binding IsPriority, Converter={StaticResource BoolToVis}}" />

            <TextBlock Grid.Row="7" Text="Weight" Style="{StaticResource Label}"
                       ToolTip="0 = default: whole computer 1, zones 2, other filters 3. Higher weight wins." />
            <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding Weight, UpdateSourceTrigger=PropertyChanged}" Margin="0,4" Padding="4,3" />

            <TextBlock Grid.Row="8" Text="Notes" Style="{StaticResource Label}" />
            <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Margin="0,4" Padding="4,3" />
        </Grid>

        <!-- Quota: size, reset and what happens on overflow -->
        <StackPanel Visibility="{Binding IsQuota, Converter={StaticResource BoolToVis}}" Margin="0,4,0,0">
            <StackPanel Orientation="Horizontal" Margin="0,4">
                <TextBlock Text="Quota" Style="{StaticResource Label}" Width="52" />
                <TextBox Width="90" Text="{Binding QuotaAmount, UpdateSourceTrigger=PropertyChanged}" Padding="4,3" />
                <ComboBox Width="120" Margin="8,0,0,0" ItemsSource="{Binding QuotaUnits}" SelectedItem="{Binding QuotaUnit}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,4">
                <TextBlock Text="Reset" Style="{StaticResource Label}" Width="52" />
                <ComboBox Width="120" ItemsSource="{Binding ResetRepeats}" SelectedItem="{Binding ResetRepeat}" />
                <DatePicker Width="130" Margin="8,0,0,0" SelectedDate="{Binding ResetDate}" Visibility="{Binding IsResetOnce, Converter={StaticResource BoolToVis}}" />
                <ComboBox Width="64" Margin="8,0,0,0" ItemsSource="{Binding DaysOfMonth}" SelectedItem="{Binding ResetDayOfMonth}"
                          Visibility="{Binding IsResetDayOfMonth, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="at" Margin="8,0,6,0" VerticalAlignment="Center" Visibility="{Binding HasResetTime, Converter={StaticResource BoolToVis}}" />
                <TextBox Width="56" Text="{Binding ResetTime, UpdateSourceTrigger=PropertyChanged}" Padding="4,3" ToolTip="Time of day, HH:mm"
                         Visibility="{Binding HasResetTime, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
            <ItemsControl ItemsSource="{Binding ResetDays}" Margin="52,2,0,4" Visibility="{Binding IsResetDays, Converter={StaticResource BoolToVis}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" Margin="0,0,8,0" MinWidth="0" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="When the quota is exceeded" FontWeight="SemiBold" Margin="0,10,0,4" />
            <CheckBox Content="Show an alert" IsChecked="{Binding OverflowAlert}" />
            <CheckBox Content="Kill its connections (IPv4 TCP only)" IsChecked="{Binding OverflowKillConnections}" Margin="0,2,0,0" />
            <TextBlock Text="Turn on these rules until the next reset:" Margin="0,8,0,4" />
            <ScrollViewer MaxHeight="110" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding OverflowChoices}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Text}" IsChecked="{Binding IsSelected}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <Button Content="Add block rule" Padding="10,3" Command="{Binding AddBlockRuleCommand}" />
                <Button Content="Add limit rule" Padding="10,3" Margin="8,0,0,0" Command="{Binding AddLimitRuleCommand}" />
                <TextBox Width="60" Margin="8,0,4,0" Text="{Binding OverflowLimitKilobytes, UpdateSourceTrigger=PropertyChanged}" Padding="4,3" />
                <TextBlock Text="KB/s" VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>
        <!-- Time conditions -->
        <DockPanel Margin="0,12,0,4">
            <Button DockPanel.Dock="Right" Content="Add" Padding="10,2" Command="{Binding AddConditionCommand}" />
            <TextBlock Text="Time conditions" FontWeight="SemiBold" VerticalAlignment="Center"
                       ToolTip="Start enables the rule, Stop disables it, Reset zeroes a quota, Delete removes the rule" />
        </DockPanel>
        <ItemsControl x:Name="ConditionsList" ItemsSource="{Binding Conditions}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:ConditionItem}">
                    <StackPanel Margin="0,2">
                        <StackPanel Orientation="Horizontal">
                            <CheckBox IsChecked="{Binding IsEnabled}" MinWidth="0" VerticalAlignment="Center" ToolTip="Enabled" />
                            <ComboBox Width="90" Margin="4,0,0,0" SelectedItem="{Binding Action}"
                                      ItemsSource="{Binding DataContext.ConditionActions, ElementName=ConditionsList}" />
                            <ComboBox Width="110" Margin="6,0,0,0" SelectedItem="{Binding Repeat}"
                                      ItemsSource="{Binding DataContext.ConditionRepeats, ElementName=ConditionsList}" />
                            <DatePicker Width="124" Margin="6,0,0,0" SelectedDate="{Binding Date}" Visibility="{Binding IsOnce, Converter={StaticResource BoolToVis}}" />
                            <ComboBox Width="64" Margin="6,0,0,0" SelectedItem="{Binding DayOfMonth}"
                                      ItemsSource="{Binding DataContext.DaysOfMonth, ElementName=ConditionsList}"
                                      Visibility="{Binding IsDayOfMonth, Converter={StaticResource BoolToVis}}" />
                            <TextBox Width="52" Margin="6,0,0,0" Padding="4,3" Text="{Binding Time, UpdateSourceTrigger=PropertyChanged}" ToolTip="Time of day, HH:mm" />
                            <Button Content="✕" Padding="6,1" Margin="6,0,0,0" ToolTip="Remove"
                                    Command="{Binding DataContext.RemoveConditionCommand, ElementName=ConditionsList}" CommandParameter="{Binding}" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Days}" Margin="24,2,0,0" Visibility="{Binding IsDays, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" Margin="0,0,8,0" MinWidth="0" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <CheckBox Content="Enabled" IsChecked="{Binding IsEnabled}" Margin="0,8,0,0" />
        <TextBlock Text="{Binding Error}" Foreground="{DynamicResource BadBrush}" Margin="0,10,0,0" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Save" Width="90" Padding="0,4" IsDefault="True" Click="Save_Click" />
            <Button Content="Cancel" Width="90" Padding="0,4" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
    </ScrollViewer>
</Window>
