<Application x:Class="NetWarden.Client.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:NetWarden.Client"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
        <!-- Our colors; ThemeManager swaps this for Themes/Dark.xaml and turns on Fluent's matching mode. -->
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="pack://application:,,,/NetWarden.Client;component/Themes/Light.xaml" />
        </ResourceDictionary.MergedDictionaries>
        <local:MatchToIndexConverter x:Key="MatchToIndex" />
        <local:EnumToBoolConverter x:Key="EnumToBool" />

        <Style x:Key="FeatureChip" TargetType="Border">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Background" Value="{DynamicResource PanelBackground}" />
        </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
